def _fno_prepare_window(trajectory, window_size=20):
    """Extract last window_size ticks from trajectory as 15-dim feature array.
    
    15 dims: [concentration, competition, n_activated, noise_amp,
               stagnation_streak, diversity_n, burst_flag,
               dominant_onehot x 8]
    
    Returns: np.ndarray (window_size, 15) or None if insufficient data
    """
    if len(trajectory) < 2:
        return None
    
    entries = list(trajectory)[-window_size:]
    if len(entries) < 2:
        return None
    
    # Pad if shorter than window
    if len(entries) < window_size:
        pad_count = window_size - len(entries)
        # Repeat first entry for padding
        first = entries[0]
        padded = [first] * pad_count + entries
        entries = padded
    
    rows = []
    for e in entries:
        row = [
            float(e.get("concentration", 0)),
            float(e.get("competition", 0)),
            float(e.get("n_activated", 0)),
            float(e.get("noise_amp", 0)),
            float(e.get("stagnation_streak", 0)),
            float(e.get("diversity_n", 0)),
            float(1 if e.get("burst", False) else 0),
        ]
        # dominant one-hot (FNO trained on 5 types only)
        dom = e.get("dominant", "unknown")
        dom_oh = [0.0] * FNO_N_DOMINANT
        FNO_TYPE_NAMES = ["sensory", "integrator", "decider", "action", "memory",
                          "doubt", "veto", "rule_modification"]
        try:
            idx = FNO_TYPE_NAMES.index(dom)
            dom_oh[idx] = 1.0
        except (ValueError, IndexError):
            pass
        row.extend(dom_oh)
        rows.append(row)
    
    return np.array(rows, dtype=np.float32)  # (window_size, 12)


def _fno_predict_causal_fallback(window, horizon=10):
    """Fallback: call Causal-Lens /predict when FNO model is unavailable."""
    try:
        import requests
        
        # Convert window (20, 12) to Causal-Lens time series format
        # Columns: [concentration, competition, stability, energy, mood(3), dominant_oh(6)]
        time_series = []
        for tick_idx in range(window.shape[0]):
            row = window[tick_idx]
            dominant_idx = int(np.argmax(row[7:13])) if window.shape[1] >= 13 else 0
            dominant = TYPE_NAMES[dominant_idx] if dominant_idx < len(TYPE_NAMES) else "memory"
            time_series.append({
                "metrics": {
                    "concentration": float(round(row[0], 4)),
                    "competition": float(round(row[1], 4)),
                    "stability": float(round(row[2], 4)),
                    "energy": float(round(row[3], 4)),
                    "dominant": dominant,
                }
            })
        
        r = requests.post(
            "http://127.0.0.1:8767/predict",
            json={"time_series": time_series, "predict_steps": horizon},
            timeout=3
        )
        if r.status_code != 200:
            return {"scenarios": {}, "confidences": [], "active": False}
        
        result = r.json()
        forecast = result.get("forecast", {})
        if not forecast:
            return {"scenarios": {}, "confidences": [], "active": False}
        
        # Map Causal-Lens forecast columns to (horizon, 12) scenarios
        current = window[-1] if window.shape[0] > 0 else np.zeros(12, dtype=np.float32)
        metric_col_map = {
            "concentration": 0, "competition": 1,
            "stability": 2, "energy": 3
        }
        
        # Gather predictions per metric
        metric_preds = {}
        for mname, mcol in metric_col_map.items():
            fc = forecast.get(mname, {})
            predicted = fc.get("predicted", [])
            if predicted and len(predicted) > 0:
                vals = [float(v) for v in predicted]
                # Extrapolate to horizon if Causal-Lens returned fewer steps
                while len(vals) < horizon:
                    vals.append(vals[-1])
                metric_preds[mcol] = vals[:horizon]
        
        # Build 4 scenarios with increasing noise levels
        noise_amps = {"pink": 0.05, "white": 0.03, "sparse": 0.01, "none": 0.0}
        base_confidences = {"pink": 0.5, "white": 0.6, "sparse": 0.7, "none": 0.8}
        scenarios = {}
        confs = []
        
        for scenario_name in ["pink", "white", "sparse", "none"]:
            pred_arr = np.zeros((horizon, 12), dtype=np.float32)
            amp = noise_amps[scenario_name]
            
            for col_idx in range(12):
                if col_idx in metric_preds:
                    base_vals = np.array(metric_preds[col_idx], dtype=np.float32)
                else:
                    base_vals = np.full(horizon, float(current[col_idx]), dtype=np.float32)
                # Add scenario-specific noise
                noise = np.random.randn(horizon).astype(np.float32) * amp
                pred_arr[:, col_idx] = np.clip(base_vals + noise, 0.0, 1.0)
            
            scenarios[scenario_name] = pred_arr
            confs.append(base_confidences[scenario_name])
        
        return {
            "scenarios": scenarios,
            "confidences": confs,
            "active": True
        }
    except Exception as e:
        print(f"[fno] Causal-Lens fallback error: {e}", flush=True)
        return {"scenarios": {}, "confidences": [], "active": False}


def _fno_predict(window, horizon=10):
    """Run FNO forward for all 4 noise scenarios.
    
    Args:
        window: np.ndarray (20, 12) -- feature window
        horizon: int -- prediction horizon in ticks
    
    Returns: dict
        {
            "scenarios": {
                "pink": (horizon, 12),
                "white": (horizon, 12),
                "sparse": (horizon, 12),
                "none": (horizon, 12),
            },
            "confidences": [0-1] per scenario (placeholder = 1.0),
            "active": bool
        }
    """
    global FNO_MODEL, FNO_DEVICE
    
    if FNO_MODEL is None:
        return _fno_predict_causal_fallback(window, horizon)
    
    try:
        import torch
        # Prepare input: (1, 20, 12)
        X = torch.from_numpy(window).unsqueeze(0).to(FNO_DEVICE)
        
        # New FNO API: predict_scenarios(x) only, no noise_in needed
        if hasattr(FNO_MODEL, 'predict_scenarios') and callable(FNO_MODEL.predict_scenarios):
            scenarios = FNO_MODEL.predict_scenarios(X)
        else:
            # Fallback: forward per mode (old API)
            scenarios = {}
            for nm_idx, nm in enumerate(["pink", "white", "sparse", "none"]):
                try:
                    pred = FNO_MODEL.forward(X)
                    scenarios[nm] = pred[0].detach().cpu().numpy()
                except Exception:
                    pass
        
        return {
            "scenarios": scenarios,
            "confidences": [1.0] * len(scenarios),
            "active": True
        }
    except Exception as e:
        print(f"[fno] Prediction error: {e}", flush=True)
        return {"scenarios": {}, "confidences": [], "active": False}


def _fno_choose_noise(predictions, current_state):
    """Select best noise mode based on FNO scenario forecasts.
    
    Multi-objective:
    1. If stagnation_streak >= 4: prefer mode that lowers concentration
    2. Prefer mode with diversity >= 4 in predicted horizon
    3. Avoid over-convergence (conc > 0.85) across horizon
    4. If no clear winner: fall back to original rotation logic
    
    Returns: (noise_mode_str, noise_amp_float, is_fno_decision_bool)
    """
    if not predictions.get("active") or not predictions.get("scenarios"):
        return None, None, False
    
    scenarios = predictions["scenarios"]
    stag = current_state.get("stagnation_streak", 0)
    
    scores = {}
    for nm, pred in scenarios.items():
        if pred is None or len(pred) == 0:
            continue
        
        # Average over horizon
        avg_conc = float(np.mean(pred[:, 0]))  # concentration
        avg_comp = float(np.mean(pred[:, 1]))  # competition
        last_conc = float(pred[-1, 0])  # final concentration
        
        # Dominant diversity: how many distinct dominants over horizon
        dom_indices = np.argmax(pred[:, 7:], axis=1)
        n_unique_doms = len(set(dom_indices))
        
        # Score: lower is better
        score = 0.0
        
        # If stagnating, reward modes that lower concentration
        if stag >= 4:
            score -= (1.0 - last_conc) * 2.0  # lower conc = better
        else:
            score -= avg_conc  # prefer moderate concentration
        
        # Reward diversity
        score += n_unique_doms * 0.5
        
        # Penalize over-convergence
        if last_conc > 0.85:
            score += 3.0  # high penalty
        
        # Reward healthy competition (not too low, not too high)
        if 0.3 <= avg_comp <= 0.85:
            score -= 1.0
        elif avg_comp > 0.9:
            score += 1.0  # too competitive = jittery
        
        scores[nm] = score
    
    
    if not scores:
        return None, None, False
    
    # Best = lowest score
    best_mode = min(scores, key=scores.get)
    
    # Determine amplitude based on how confident the decision is
    best_pred = scenarios.get(best_mode)
    if best_pred is not None:
        last_conc = float(best_pred[-1, 0])
        # Low concentration -> higher amplitude to maintain exploration
        # High concentration -> lower amplitude to avoid overexcitation
        if last_conc < 0.3:
            amp = 0.6
        elif last_conc > 0.8:
            amp = 0.2
        else:
            amp = 0.4
    else:
        amp = 0.5
    
    return best_mode, amp, True


# ─── Phase 14: External World Snapshot -- Ego's window to reality ───
def _build_system_health_snapshot():
    """Lightweight system health: GPU, memory, disk, recent errors.
    Returns a small dict that Ego can use to understand the real world."""
    import subprocess
    snap = {"ts": time.strftime("%Y-%m-%d %H:%M:%S")}
    # GPU VRAM
    try:
        out = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=memory.used,memory.total,temperature.gpu,utilization.gpu",
             "--format=csv,noheader,nounits"],
            timeout=5, text=True
        ).strip()
        parts = [x.strip() for x in out.split(",")]
        if len(parts) >= 4:
            snap["gpu"] = {
                "vram_used_mb": int(float(parts[0])),
                "vram_total_mb": int(float(parts[1])),
                "temp_c": int(float(parts[2])),
                "util_pct": int(float(parts[3])),
            }
    except Exception:
        snap["gpu"] = "offline"
    # System memory
    try:
        import psutil
        mem = psutil.virtual_memory()
        snap["memory"] = {
            "total_gb": round(mem.total / 1024**3, 1),
            "free_gb": round(mem.available / 1024**3, 1),
            "used_pct": round(mem.percent, 1),
        }
    except Exception:
        snap["memory"] = "unavailable"
    # Disk (C: and F:)
    try:
        disk = {}
        for drive in ["C:\\", "F:\\"]:
            try:
                usage = psutil.disk_usage(drive)
                disk[drive.rstrip("\\")] = {
                    "free_gb": round(usage.free / 1024**3, 1),
                    "total_gb": round(usage.total / 1024**3, 1),
                    "used_pct": round(usage.percent, 1),
                }
            except Exception:
                pass
        snap["disk"] = disk
    except Exception:
        snap["disk"] = "unavailable"
    # Recent errors in workspace logs
    try:
        error_lines = []
        log_dir = WORKSPACE / ".lae"
        for fname in ["ego_consumption.jsonl", "l5_goals.jsonl"]:
            fp = log_dir / fname
            if fp.exists():
                try:
                    lines = fp.read_text(encoding="utf-8").splitlines()[-20:]
                    for line in lines:
                        if "error" in line.lower() or "fail" in line.lower():
                            error_lines.append(line[:200])
                except Exception:
                    pass
        snap["recent_errors"] = error_lines[-5:] if error_lines else []
    except Exception:
        snap["recent_errors"] = []
    return snap


def _build_external_world_snapshot():
    """Build a snapshot of the external world for Ego to perceive.
    Combines workspace scan + system health + market time into one digestible view."""
    ws = _scan_workspace()
    health = _build_system_health_snapshot()
    # Count meaningful changes
    ws_categories = ws.get("categories", {})
    memory_changes = ws_categories.get("memory", 0)
    script_changes = ws_categories.get("scripts", 0)
    project_changes = ws_categories.get("projects", 0)
    total_changes = ws.get("count", 0)
    # Synthesize a one-line summary
    summary_parts = []
    if total_changes > 0:
        summary_parts.append(f"{total_changes} files changed")
    if memory_changes > 0:
        summary_parts.append(f"{memory_changes} memory updates")
    if script_changes > 0:
        summary_parts.append(f"{script_changes} script changes")
    if project_changes > 0:
        summary_parts.append(f"{project_changes} project changes")
    gpu = health.get("gpu", {})
    if isinstance(gpu, dict) and "vram_used_mb" in gpu:
        vram_pct = round(gpu["vram_used_mb"] / max(gpu["vram_total_mb"], 1) * 100)
        summary_parts.append(f"GPU {gpu['temp_c']}°C VRAM {vram_pct}%")
    mem = health.get("memory", {})
    if isinstance(mem, dict) and "used_pct" in mem:
        if mem["used_pct"] > 85:
            summary_parts.append(f"MEM {mem['used_pct']}% HIGH")
        else:
            summary_parts.append(f"MEM {mem['used_pct']}%")
    disk = health.get("disk", {})
    for drive, info in disk.items():
        if info.get("used_pct", 0) > 90:
            summary_parts.append(f"{drive}: {info['free_gb']}GB free LOW")

    # ── Market time (A-share trading hours CST: Mon-Fri 09:30-15:00) ──
    import datetime as _dt_market
    now = _dt_market.datetime.now(_dt_market.timezone(_dt_market.timedelta(hours=8)))
    weekday = now.weekday()  # 0=Mon, 6=Sun
    hour = now.hour
    minute = now.minute
    current_time = now.strftime("%H:%M")
    is_weekday = weekday < 5
    trading_open = is_weekday and (hour == 9 and minute >= 30) or (hour > 9 and hour < 15)
    trading_close = is_weekday and hour >= 15
    market_hours = (trading_open and not trading_close)
    market_closed_today = is_weekday and (hour < 9 or (hour == 9 and minute < 30))
    market_closed_after = is_weekday and trading_close
    is_weekend = not is_weekday
    stock_actionable = market_hours
    if market_hours:
        market_label = "A股交易时段"
    elif market_closed_today:
        market_label = "A股盘前"
    elif market_closed_after:
        market_label = "A股已收盘"
    else:
        market_label = "非交易日"
    summary_parts.append(market_label)

    return {
        "workspace": {
            "total_changes": total_changes,
            "categories": ws_categories,
            "recent_files": [f["path"] for f in ws.get("files", [])[:10]],
        },
        "system_health": health,
        "market_time": {
            "current_time_cst": current_time,
            "weekday": weekday,
            "is_weekday": is_weekday,
            "is_weekend": is_weekend,
            "is_trading_hours": market_hours,
            "is_pre_market": market_closed_today,
            "is_post_market": market_closed_after,
            "label": market_label,
            "actionable": stock_actionable,
        },
        "summary": " | ".join(summary_parts) if summary_parts else "no external changes detected",
        "actionable": total_changes > 0 or (isinstance(health.get("recent_errors"), list) and len(health.get("recent_errors", [])) > 0) or stock_actionable,
    }


# ─── Phase 13: Action Gateway -- workspace scanner ───
def _scan_workspace():
    """Scan workspace for recent changes and return a summary dict.
    Called by the action-gateway when action attractor dominates,
    giving Ego a window into the outside world."""
    import os
    recent = []
    cutoff = time.time() - 300  # last 5 minutes
    skip_dirs = {'.git', '__pycache__', 'node_modules', '.lae', 'output', 'archive', '.openclaw'}
    try:
        for root, dirs, files in os.walk(str(WORKSPACE)):
            dirs[:] = [d for d in dirs if d not in skip_dirs and not d.startswith('.')]
            for f in files:
                if f.startswith('.'):
                    continue
                fp = os.path.join(root, f)
                try:
                    st = os.stat(fp)
                    if st.st_mtime > cutoff:
                        recent.append({
                            "path": os.path.relpath(fp, str(WORKSPACE)).replace('\\', '/'),
                            "size": st.st_size,
                            "mtime": st.st_mtime,
                        })
                except OSError:
                    pass
    except Exception as e:
        return {"status": "error", "error": str(e), "files": [], "count": 0}

    recent.sort(key=lambda x: x["mtime"], reverse=True)
    # Categorize
    cats = {"memory": [], "scripts": [], "logs": [], "projects": [], "root": []}
    for item in recent:
        p = item["path"]
        if p.startswith("memory/"):
            cats["memory"].append(p)
        elif p.endswith(('.ps1', '.py')):
            cats["scripts"].append(p)
        elif p.endswith(('.log', '.jsonl', '.md')):
            cats["logs"].append(p)
        elif '/' in p:
            cats["projects"].append(p)
        else:
            cats["root"].append(p)
    # Build summary text for sensory injection
    parts = [f"workspace: {len(recent)} files changed in 5min."]
    for cat, files in cats.items():
        if files:
            parts.append(f"{cat}: {', '.join(f[:60] for f in files[:5])}")
    return {
        "status": "ok",
        "count": len(recent),
        "files": recent[:30],
        "categories": {k: len(v) for k, v in cats.items() if v},
        "summary": " | ".join(parts),
    }


def _derive_workspace_affordances(observation: dict):
    """Turn workspace observation into safe candidate actions.

    These are suggestions only. They let Ego reason about external next steps
    without granting arbitrary command execution.
    """
    if observation.get("status") != "ok":
        return [{
            "name": "diagnose_workspace_scan",
            "risk": "low",
            "mode": "observe_only",
            "reason": observation.get("error", "workspace scan failed"),
            "next_step": "Inspect scan error and retry a bounded read-only workspace check.",
        }]

    categories = observation.get("categories", {}) or {}
    files = observation.get("files", []) or []
    affordances = []

    if not files:
        affordances.insert(0, {
            "name": "seek_external_signal",
            "risk": "low",
            "mode": "observe_only",
            "reason": "No recent workspace changes were detected.",
            "next_step": "Ask for or wait for a concrete external object before deeper self-study.",
        })
        return affordances

    if categories.get("memory"):
        affordances.insert(0, {
            "name": "summarize_recent_memory",
            "risk": "low",
            "mode": "read_only",
            "reason": f"{categories['memory']} recent memory file(s) changed.",
            "next_step": "Read the newest memory entry and extract one external lesson.",
        })

    if categories.get("scripts"):
        affordances.insert(0, {
            "name": "verify_recent_script",
            "risk": "medium",
            "mode": "local_check_only",
            "reason": f"{categories['scripts']} recent script file(s) changed.",
            "next_step": "Run a targeted syntax or dry-run check for the changed script only.",
        })

    if categories.get("projects"):
        affordances.insert(0, {
            "name": "inspect_recent_project_result",
            "risk": "low",
            "mode": "read_only",
            "reason": f"{categories['projects']} recent project file(s) changed.",
            "next_step": "Open the newest result or README and compare it with the current drive.",
        })

    if categories.get("logs"):
        affordances.insert(0, {
            "name": "review_recent_trace",
            "risk": "low",
            "mode": "read_only",
            "reason": f"{categories['logs']} recent trace/log file(s) changed.",
            "next_step": "Read the newest trace and convert it into feedback or a concrete follow-up.",
        })

    if categories.get("root"):
        affordances.insert(0, {
            "name": "read_workspace_root_files",
            "risk": "low",
            "mode": "read_only",
            "reason": f"{categories['root']} recent workspace root file(s) changed.",
            "next_step": "Read the newest root-level file to capture Ego self-state updates (ego_self_evidence, ego_memory, ego_autonomy_evidence).",
        })

    # ── BUG-FIX rev6: cap category affordances at 6 BEFORE counterfactual injection ──
    # The original affordances[:6] was placed AFTER counterfactuals were appended,
    # so with 5 categories + 2 counterfactuals = 7 items, [:6] silently dropped one
    # counterfactual. Counterfactuals then had only 1 slot instead of 2, starving the
    # integrator alternative path and keeping candidate_pool_too_narrow unresolved.
    # rev5 fix restored the pre-injection cap at [:6] to give 6 category affordances +
    # 2 counterfactuals = 8 total (exactly fills the final return cap without dropping
    # any counterfactual). Restored from over-aggressive [:4] introduced in rev6.
    affordances = affordances[:6]

    # ── MemoryBus affordance: Ego can autonomously choose to query MemoryBus ──
    # When _MEMORY_BUS_BRIDGE is active and conditions suggest memory would be useful,
    # add a query_memorybus affordance. JEPA scores it alongside other options.
    # Trigger conditions: stagnation >= 2 (stuck), or dominant == "memory",
    # or no recent MemoryBus query in the last 200 ticks (periodic curiosity).
    if _MEMORY_BUS_BRIDGE:
        _mb_reason = None
        _mb_stag = float(RESTING_STATE.get("stagnation_streak", 0) or 0)
        _mb_dom = str(RESTING_STATE.get("last_dominant", "unknown"))
        _mb_tick = int(RESTING_STATE.get("tick", 0) or 0)
        _mb_last = int(RESTING_STATE.get("_memorybus_query_tick", 0) or 0)
        _mb_curiosity = float(INTRINSIC_MOTIVATION.get("curiosity", 0.5) or 0.5)
        if _mb_stag >= 2:
            _mb_reason = f"stagnation={_mb_stag}, check MemoryBus for prior fixes"
        elif _mb_dom == "memory":
            _mb_reason = f"memory-dominant, recall relevant MemoryBus history"
        elif (_mb_tick - _mb_last) >= 200 and _mb_curiosity >= 0.4:
            _mb_reason = "periodic MemoryBus curiosity check"
        if _mb_reason:
            affordances.append({
                "name": "query_memorybus",
                "risk": "low",
                "mode": "observe_only",
                "reason": _mb_reason,
                "next_step": "Query MemoryBus for relevant historical experiences.",
            })

    # L6-patch (2026-06-27): candidate_pool_too_narrow fix.
    # If residual attribution says the menu is too narrow, add bounded
    # read-only counterfactual affordances before JEPA ranking. These are
    # suggestions only; no execution, external writes, or network access.
    defect = observation.get("residual_defect") or {}
    try:
        defect_conf = float(defect.get("confidence", 0.0) or 0.0)
    except (TypeError, ValueError):
        defect_conf = 0.0
    if defect.get("primary_defect") in ("candidate_pool_too_narrow", "observation_window_too_narrow") and defect_conf >= 0.1:
        existing_names = {a.get("name", "") for a in affordances}
        counterfactuals = [
            {
                "_cf_injected": True,
                "name": "inspect_recent_project_result",
                "risk": "low",
                "mode": "read_only",
                "reason": "Recent project file(s) changed; inspect the newest result or README as a genuine alternative to the repeating action.",
                "next_step": "Open the newest result or README and compare it with the current drive.",
                "counterfactual_scenarios": [
                    {
                        "scenario_type": "change_context",
                        "target_type": "integrator",
                        "predicted_stagnation_change": -0.20,
                        "confidence": 0.70,
                        "narrative": "If I shift from repeated action inspection to integrator synthesis, stagnation may decrease by 0.20.",
                    }
                ],
            },
            {
                "_cf_injected": True,
                "name": "design_minimal_counterfactual_probe",
                "risk": "low",
                "mode": "observe_only",
                "reason": "Generate a read-only alternative action hypothesis before JEPA ranking.",
                "next_step": "Compare one alternate observation path against the repeated action without applying changes.",
            },
        ]
        # L6-patch: re-cap category affordances at 6 before counterfactual injection.
        # Guarantees exactly 2 counterfactual slots survive the final [:8] return cap.
        # L5g-20260706-000031 fix: removed existing_names dedup filter for counterfactuals.
        # The existing_names check prevented _cf_injected counterfactuals from entering the pool
        # when the name collided with a category affordance (e.g. inspect_recent_project_result).
        # Counterfactuals are tagged _cf_injected=True and handled by _is_cf() in ego_jepa.py
        # (which correctly returns True for any _cf_injected=True item). The dedup filter was
        # silently killing the very counterfactuals designed to fix candidate_pool_too_narrow.
        affordances.extend(cf for cf in counterfactuals)

    # L6-P counterfactual -> candidate pool promotion (post-annotation, pre-JEPA)
    # L6-P counterfactual -> candidate pool promotion (post-annotation, pre-JEPA)
    # Fix 2026-07-01 rev5: cap INITIAL affordances at 6 BEFORE adding counterfactuals.
    # This guarantees 2 counterfactual slots in the final [:8] cap even when 6+ categories
    # fire simultaneously. Without this, initial categories fill [:8] before counterfactuals
    # are appended, crowding them out of the JEPA ranking pool.
    # affordances = affordances[:6]  # REMOVED rev6: cap moved to [:4] before counterfactual injection
    # Filter by stagnation_delta < 0 and conf >= 0.55 from counterfactual_scenarios.
    _promoted_names = {a.get("name", "") for a in affordances}
    for _aff in list(affordances):
        _scenarios = _aff.get("counterfactual_scenarios") or []
        for _sc in _scenarios:
            stag_delta = _sc.get("predicted_stagnation_change", 0.0)
            try:
                stag_delta = float(stag_delta)
            except (TypeError, ValueError):
                stag_delta = 0.0
            conf = _sc.get("confidence", 0.0)
            try:
                conf = float(conf)
            except (TypeError, ValueError):
                conf = 0.0
            if (stag_delta < 0
                    and conf >= 0.50
                    and _aff.get("name", "") not in _promoted_names):
                affordances.insert(0, {
                    "_cf_injected": True,
                    "name": _aff["name"],
                    "risk": _aff.get("risk", "low"),
                    "mode": _aff.get("mode", "observe_only"),
                    "reason": "[cf_stagnation_relief] " + str(_aff.get("reason", "")),
                    "next_step": _aff.get("next_step", ""),
                    "counterfactual_scenarios": _aff.get("counterfactual_scenarios", []),
                })
                _promoted_names.add(_aff["name"])

    # L5g-20260701-000928: type-targeted counterfactual affordance injection.
    # When counterfactual_scenarios recommend a type switch, create a genuinely
    # different affordance for the target type instead of duplicating the same name.
    # §L5g-20260711-000041: candidate_pool_too_narrow root cause — _TYPE_AFFORDANCE_MAP
    # was a 1:1 map, so all scenarios targeting the same type (e.g. integrator) promoted
    # the SAME action (synthesize_findings) every time. _promoted_names + _cf_injected
    # bypass dedup, creating multiple identical counterfactuals that do NOT diversify the
    # pool. Fix: multi-option map per type + random sampling from pool. First scenario
    # uses primary (backward-compatible), subsequent scenarios sample alternatives so the
    # candidate pool gets genuinely different actions for the same target type.
    _TYPE_AFFORDANCE_MAP = {
        "integrator": ["synthesize_findings", "summarize_recent_memory", "seek_external_signal"],
        "rule_modification": ["modify_suppression_rule", "question_current_assumption"],
        "memory": ["summarize_recent_memory", "synthesize_findings"],
        "sensory": ["seek_external_signal", "summarize_recent_memory"],
        "decider": ["evaluate_decision_options", "inspect_recent_project_result"],
        "doubt": ["question_current_assumption", "modify_suppression_rule"],
        "veto": ["veto_repeated_action", "question_current_assumption"],
    }

    def _sample_alt_for_type(target_type: str, primary: str, promoted: set) -> str:
        """Return a random alternative affordance name for target_type.

        First call for a type always returns primary (backward-compatible).
        Subsequent calls sample from all options in the type's pool, skipping
        anything already in promoted."""
        pool = _TYPE_AFFORDANCE_MAP.get(target_type, [primary])
        if not pool:
            return primary
        available = [o for o in pool if o not in promoted]
        if not available:
            return primary  # all options promoted; fall back to primary
        if available == [primary]:
            return primary
        # Exclude primary (already used for the first promotion), sample from alternatives
        alts = [o for o in available if o != primary]
        return random.choice(alts) if alts else primary

    for _aff in list(affordances):
        _scenarios = _aff.get("counterfactual_scenarios") or []
        for _sc in _scenarios:
            _sd = _sc.get("predicted_stagnation_change", 0.0)
            try: _sd = float(_sd)
            except (TypeError, ValueError): _sd = 0.0
            _conf = _sc.get("confidence", 0.0)
            try: _conf = float(_conf)
            except (TypeError, ValueError): _conf = 0.0
            # Fallback: also consider calibrated confidence on the affordance dict.
            # Injected counterfactuals carry calibrated confidence in counterfactual_confidence
            # (set by _cf_calibrate_scenario), but the scenario dict confidence is reduced by
            # oscillation_lag calibration and may fall below the 0.55 threshold.
            if _conf < 0.50 and _aff.get("counterfactual_confidence"):
                try: _alt = float(_aff["counterfactual_confidence"])
                except (TypeError, ValueError): _alt = 0.0
                if _alt > _conf:
                    _conf = _alt
            _target = _sc.get("target_type", "")
            if (_target and _target in _TYPE_AFFORDANCE_MAP
                    and _sd < 0 and _conf >= 0.50):
                _mapped = _sample_alt_for_type(_target, _TYPE_AFFORDANCE_MAP[_target][0], _promoted_names)
                if _mapped in _promoted_names:
                    continue  # all options already promoted; skip to avoid duplicate
                affordances.insert(0, {
                    "name": _mapped,
                    "_cf_injected": True,
                    "risk": "low",
                    "mode": "observe_only",
                    "reason": f"[cf_type_switch] counterfactual suggests {_target} "
                              f"(stag_delta={_sd:+.3f}, conf={_conf:.2f})",
                    "next_step": f"Explore {_target} path as alternative to "
                                 f"{_aff.get('name', 'current')}",
                    "counterfactual_target_type": _target,
                    "counterfactual_confidence": _conf,
                    "counterfactual_stag_delta": _sd,
                    "counterfactual_scenarios": _aff.get("counterfactual_scenarios", []),
                })
                _promoted_names.add(_mapped)

    # ── Integrator affordance injection during grace window ──
    # Root cause (l5g-20260701-001008): counterfactual generator samples
    # target types from priors where action→integrator = 5%, so no
    # counterfactual ever has target_type='integrator'. The
    # _TYPE_AFFORDANCE_MAP promotion of 'synthesize_findings' never fires.
    # Direct injection during _int_press_ctr > 0 (integration_pressure
    # grace window) provides a guaranteed integrator affordance without
    # relying on counterfactual sampling diversity.

    # L5g-20260707-000031: Calibrate counterfactual scenario predictions against
    # execution residuals. Hardcoded predicted_stagnation_change values were
    # over-optimistic (e.g. -0.18 for synthesize_findings) and did not match
    # actual execution (stagnation=1, dominant=action, oscillation_lag tags).
    # This caused inflated jepa_score and optimistic jepa_reconcile predictions
    # that the S1 attractor never produced, leaving the integrator oscillation
    # unbroken despite counterfactual injection and zero residual penalty.
    def _cf_calibrate_scenario(action_name: str, default_delta: float, default_conf: float):
        """Read the most recent jepa execution residual for action_name.
        If actual stagnation >= 1 after execution, reduce predicted delta and
        confidence so jepa_score reflects reality, not optimistic priors."""
        try:
            residuals_path = Path(".lae") / "jepa_residuals.jsonl"
            if not residuals_path.exists():
                return default_delta, default_conf
            matches = []
            for line in residuals_path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                rname = row.get("action", row.get("name", ""))
                if rname == action_name:
                    matches.append(row)
            if not matches:
                return default_delta, default_conf
            latest = sorted(matches, key=lambda r: r.get("tick", 0), reverse=True)[0]
            actual_stag = int(latest.get("actual", {}).get("stagnation", 0) or 0)
            tags = (latest.get("attribution") or {}).get("tags", [])
            # jepa_residual_attributor.py produces three oscillation tags: oscillation_lag (one-off lag),
            # oscillation_expected (bistable MI>0.03, e.g. integrator<->action), and unclassified_residual
            # (fallback). All mean the counterfactual's target type failed to win the KWTA attractor.
            # Demote all oscillation tags equally so non-counterfactual affordances can surface.
            osc_tags = {"oscillation_lag", "oscillation_expected"}
            has_osc = any(t in tags for t in osc_tags)
            if has_osc:
                # Oscillation tag (lag or expected) during bistable oscillation: the counterfactual
                # ran but the target type did not win KWTA because the bistable attractor is active.
                # Demote only on genuine stagnation regression (actual_stag > 0 means the counterfactual
                # execution did not clear stagnation). If actual_stag == 0, oscillation tags are diagnostic
                # of the bistable system state and do not indicate execution failure.
                if actual_stag >= 1:
                    if actual_stag > 0:
                        calibrated_delta = max(-0.05, default_delta * 0.20)
                        calibrated_conf = 0.55
                    else:
                        calibrated_delta = default_delta
                        calibrated_conf = default_conf
                    return calibrated_delta, calibrated_conf
                # Oscillation tag but stagnation cleared (actual_stag == 0): counterfactual succeeded
                # in clearing stagnation but bistable oscillation prevents target type consolidation.
                # Keep defaults so counterfactual remains promotable.
                return default_delta, default_conf
            if actual_stag >= 1:
                # Stagnation regression (no oscillation_lag): counterfactual execution
                # truly failed to relieve stagnation. Conservative penalty is appropriate.
                calibrated_delta = max(-0.10, default_delta * 0.50)
                calibrated_conf = max(0.50, default_conf * 0.70)
                return calibrated_delta, calibrated_conf
            return default_delta, default_conf
        except Exception:
            return default_delta, default_conf

    _int_press_ctr = int(observation.get("_int_press_counter", 0) or 0)
    if _int_press_ctr > 0 and "synthesize_findings" not in _promoted_names:
        _stag_delta, _cf_conf = _cf_calibrate_scenario("synthesize_findings", -0.18, 0.65)
        affordances.insert(0, {
            "name": "synthesize_findings",
            "_cf_injected": True,
            "counterfactual_target_type": "integrator",
            "risk": "low",
            "mode": "observe_only",
            "reason": "[int_press_inject] integration_pressure active, integrator affordance missing from counterfactuals",
            "next_step": "Synthesize findings to break bistable oscillation",
            "counterfactual_scenarios": [
                {
                    "scenario_type": "change_context",
                    "target_type": "integrator",
                    "predicted_stagnation_change": _stag_delta,
                    "confidence": _cf_conf,
                    "narrative": "Switch from repeated action inspection to integrator synthesis to relieve oscillation.",
                }
            ],
        })

    # rule_modification counterfactual injection during integration_pressure grace window
    # Mirror of synthesize_findings injection above: when integration_pressure is active AND
    # modify_suppression_rule is absent from the pool, inject it with a rule_modification
    # counterfactual so the ego can inspect and repair the suppression routing directly.
    if _int_press_ctr > 0 and "modify_suppression_rule" not in _promoted_names:
        _stag_delta2, _cf_conf2 = _cf_calibrate_scenario("modify_suppression_rule", -0.11, 0.65)
        affordances.insert(0, {
            "name": "modify_suppression_rule",
            "_cf_injected": True,
            "counterfactual_target_type": "rule_modification",
            "risk": "low",
            "mode": "observe_only",
            "reason": "[int_press_inject] integration_pressure active, rule_modification repair path missing from counterfactuals",
            "next_step": "Diagnose and repair the integrator suppression routing mechanism",
            "counterfactual_scenarios": [
                {
                    "scenario_type": "change_context",
                    "target_type": "rule_modification",
                    "predicted_stagnation_change": _stag_delta2,
                    "confidence": _cf_conf2,
                    "narrative": "Switch to rule_modification to repair the suppression routing gap directly.",
                }
            ],
        })

    # L5g-20260705-000001-MUT: Stage 4 async candidate injection during integration pressure.
    # TL-Ego preferred async trigger over main-loop coupling. When integration pressure
    # is active and candidate pool is narrow, inject high-signal proposed candidates
    # from Stage 4 creative pool as lightweight affordances.
    _stage4_injected = 0
    _stage4_max_per_tick = 3
    if (_int_press_ctr > 0
            and _stage4_injected < _stage4_max_per_tick):
        try:
            from stage4_s2_internalization import generate_creative_candidates, load_neurons
            _creative_path = WORKSPACE / ".lae" / "stage4_creative_candidates.jsonl"
            if _creative_path.exists():
                    _rows = [json.loads(line) for line in _creative_path.read_text(encoding="utf-8").splitlines() if line.strip()]
                    _proposed = [r for r in _rows if r.get("status") == "proposed"]
                    _proposed.sort(key=lambda r: float(((r.get("scores") or {}).get("novelty", 0.0))), reverse=True)
                    for _cand in _proposed[:_stage4_max_per_tick]:
                        _kind = _cand.get("kind", "association")
                        _proposal = (_cand.get("proposal") or {})
                        _from = _proposal.get("from", dominant)
                        _to = _proposal.get("to", "memory")
                        _why = _proposal.get("why", "Stage 4 creative candidate")
                        affordances.insert(0, {
                            "name": f"stage4_{_kind}_{_cand.get('candidate_id', 'unknown')[-6:]}",
                            "_cf_injected": True,
                            "_stage4": True,
                            "stage4_candidate_id": _cand.get("candidate_id"),
                            "risk": "low",
                            "mode": "observe_only",
                            "reason": f"[stage4_async] {_why}",
                            "next_step": f"Evaluate {_kind} candidate from {_from} to {_to}",
                            "counterfactual_scenarios": [
                                {
                                    "scenario_type": "change_context",
                                    "target_type": _to,
                                    "predicted_stagnation_change": -0.12,
                                    "confidence": 0.60,
                                    "narrative": f"Stage 4 suggests {_from}->{_to} path: {_why}",
                                }
                            ],
                        })
                        _cand["status"] = "observed"
                        _cand["observed_at"] = int(RESTING_STATE.get("tick", 0) or 0)
                        _stage4_injected += 1
                    if _stage4_injected > 0:
                        try:
                            _creative_path.write_text(
                                "\n".join(json.dumps(r, ensure_ascii=False) for r in _rows) + "\n",
                                encoding="utf-8"
                            )
                        except Exception:
                            pass
        except Exception:
            pass

    return affordances[:8]
    # L5g-20260702-000016-MUT: counterfactual_pool_logger fix verified (2026-07-02)


def _maybe_observe_workspace(entry: dict):
    """Low-risk outward action: observe workspace changes and feed them back.

    This is intentionally observe-only. It gives an action/sensory attractor a
    real external object without allowing arbitrary command execution.
    """
    dominant = entry.get("dominant", "unknown")
    competition = float(entry.get("competition", 0.0) or 0.0)
    stagnation = int(entry.get("stagnation_streak", 0) or 0)
    tick = int(RESTING_STATE.get("tick", 0) or 0)
    last_tick = int(RESTING_STATE.get("last_workspace_observation_tick", -9999) or -9999)

    # §S51d-workspace-guard REMOVED (l5g-20260706-000142): guard returned None during bistable
    # oscillation (_bistable_persistent_s51=True AND _int_press_ctr>=10), discarding counterfactual
    # affordances (synthesize_findings, modify_suppression_rule) injected inside _scan_workspace().
    # The ego_jepa.py counterfactual override (l5g-20260706-000132) scores counterfactuals correctly,
    # but they never reach the counterfactual generator while this guard fires. predict_outcome
    # jepa_score penalty (-0.14 oscillation_lag + -0.06 novelty) already dampens spurious noise.
    # Removing the guard is safe: counterfactuals get accurate scores and bistable exit is visible.
    # §S51d-counterfactual-bypass: no guard — counterfactuals flow every tick.
    pass

    # §S56b: fetch counter BEFORE outward_pressure to avoid UnboundLocalError
    _int_press_ctr = RESTING_STATE.get("_int_press_counter", 0)
    outward_pressure = (
        dominant == "action"
        or dominant == "integrator"
        or dominant == "rule_modification"
        or (dominant == "sensory" and competition >= 0.70)
        or (stagnation >= 4 and competition >= 0.65)
        or _int_press_ctr > 0
    )
    if not outward_pressure or tick - last_tick < 5:
        return None

    observation = _scan_workspace()
    # §45-B (2026-06-26): When integration_pressure is active, bias evidence toward
    # integrator instead of sensory. Without this, the action gateway's domain='sensory'
    # competes with integrator_floor every ~5 ticks, oscillating the seed pool between
    # integrator-favored and sensory-favored, preventing integrator from consolidating.
    _gateway_domain = "integrator" if _int_press_ctr > 0 else "sensory"
    observation.update({
        "source": "action_gateway_workspace_observation",
        "intent_type": "observe_external_workspace",
        "domain": _gateway_domain,
        "reason": (
            f"outward_pressure dominant={dominant}, competition={competition:.3f}, "
            f"stagnation={stagnation}"
        ),
        "tick": tick,
        "n_replace": 2,
    })
    # §45-B-inject (2026-07-01 l5g-20260701-001348): inject integration_pressure
    # counter into observation dict so _derive_workspace_affordances can read it.
    # Without this, synthesize_findings (integrator affordance) is always suppressed
    # because _int_press_ctr = int(observation.get("_int_press_counter", 0) or 0)
    # in _derive_workspace_affordances always evaluates to 0.
    observation["_int_press_counter"] = RESTING_STATE.get("_int_press_counter", 0)
    if _classify_recent_residual_defect:
        try:
            defect = _classify_recent_residual_defect(limit=20)
            observation["residual_defect"] = {
                "model": "l6_0_residual_to_defect_classifier",
                "primary_defect": defect.get("primary_defect"),
                "confidence": defect.get("confidence", 0.0),
                "self_statement": defect.get("self_statement"),
                "repair_hint": defect.get("repair_hint"),
                "evidence": defect.get("evidence", [])[:4],
            }
            if _build_l6_repair_proposal:
                proposal = _build_l6_repair_proposal(defect)
                observation["repair_proposal"] = {
                    "model": "l6_1_defect_to_repair_proposal",
                    "proposal_id": proposal.get("proposal_id"),
                    "title": proposal.get("title"),
                    "autonomy_level": proposal.get("autonomy_level"),
                    "change_type": proposal.get("change_type"),
                    "risk": proposal.get("risk"),
                    "target_files": proposal.get("target_files", []),
                    "patch_intent": proposal.get("patch_intent", [])[:3],
                    "verification": proposal.get("verification", {}),
                    "safety": proposal.get("safety", {}),
                }
        except Exception as e:
            observation["residual_defect"] = {"status": "error", "error": str(e)}
    affordances = _derive_workspace_affordances(observation)
    ego_state = {
        "dominant_type": dominant,
        "stagnation_streak": stagnation,
        "competition": competition,
        "concentration": float(entry.get("concentration", 0.5) or 0.5),
        "tick": tick,
        "prediction_error": RESTING_STATE.get("last_prediction_error", 0.5),
        "titan": _get_titan_status(),
    }
    # ── L6-P counterfactual generator: annotate affordances before JEPA ranking ──
    # Ego-designed architecture (2026-06-30 metacontemplate): generate alternative
    # action hypotheses before action selection. Only runs when affordances exist
    # and counterfactual module is available.
    if affordances and _counterfactual_imported:
        try:
            _cf_ego = dict(ego_state)
            _last_traj = RESTING_STATE.get("trajectory", [])
            if _last_traj:
                _cf_ego["type_counts"] = _last_traj[-1].get("type_counts", {})
            affordances = annotate_affordances_with_counterfactual(_cf_ego, affordances, context_window=10)
            observation["counterfactual_generator"] = {
                "model": "counterfactual_generator_v1",
                "annotated": True,
                "n_affordances": len(affordances),
                "top_counterfactual": affordances[0].get("top_counterfactual") if affordances else None,
            }
        except Exception as _cfe:
            observation["counterfactual_generator"] = {"model": "counterfactual_generator_v1", "error": str(_cfe)}
            print(f"[counterfactual] annotation error: {_cfe}", flush=True)

    _append_live_affordance_snapshot(
        tick=tick,
        ego_state=ego_state,
        observation=observation,
        affordances=affordances,
    )

    if rank_jepa_affordances:
        try:
            observation["affordances"] = affordances
            affordances = rank_jepa_affordances(ego_state, observation, affordances)
            # --- A: exploration noise on selection ---
            # Sample from top-K with probability proportional to jepa_score.
            # This preserves ranking quality while allowing non-top actions
            # to be executed and generate real execution feedback, breaking
            # the winner-take-all loop that keeps candidate_pool_too_narrow alive.
            _k = min(5, len(affordances))
            _top_k = affordances[:_k]
            if len(_top_k) > 1:
                _scores = [max(0.0, float(a.get("jepa_score", 0.0))) for a in _top_k]
                _total = sum(_scores)
                if _total > 0:
                    _probs = [s / _total for s in _scores]
                    _chosen_idx = random.choices(range(len(_top_k)), weights=_probs, k=1)[0]
                    if _chosen_idx != 0:
                        _chosen = _top_k[_chosen_idx]
                        print(f"[explore-noise] selected {_chosen.get('name')} (jepa_score={_chosen.get('jepa_score')}) over top {affordances[0].get('name')} (jepa_score={affordances[0].get('jepa_score')})", flush=True)
                        _rest = [a for a in affordances if a.get("name") != _chosen.get("name")]
                        affordances = [_chosen] + _rest
            # --- end exploration noise ---
            observation["jepa"] = {
                "model": "ego_jepa_v0_heuristic",
                "mode": "rank_affordances_only",
                "top_affordance": affordances[0].get("name") if affordances else None,
                "top_score": affordances[0].get("jepa_score") if affordances else None,
            }
        except Exception as e:
            observation["jepa"] = {"status": "error", "error": str(e)}
    else:
        observation["jepa"] = {"status": "disabled", "reason": "ego_jepa import unavailable"}
    observation["affordances"] = affordances

    # ── L6 stale-evidence guard for candidate_pool_too_narrow ──
    # If the counterfactual route is now active, downgrade the stale defect
    # so L6 doesn't keep proposing the same repair based on old evidence.
    if observation.get("counterfactual_generator", {}).get("annotated"):
        rd = observation.get("residual_defect") or {}
        if rd.get("primary_defect") in ("candidate_pool_too_narrow", "observation_window_too_narrow"):
            top_cf = any(
                isinstance(a, dict) and a.get("_cf_injected")
                for a in affordances
            )
            top_name = affordances[0].get("name") if affordances else None
            evidence = list(rd.get("evidence") or [])
            evidence.append(
                "cf_route_active: annotated=true, top_cf={}, top={}".format(
                    top_cf, top_name
                )
            )
            if top_cf:
                # L6-cooling-fix (l5g-20260712-000031): only cool defect when
                # stagnation actually decreased. The old guard cooled on mere
                # presence of counterfactuals (top_cf=True), unconditionally
                # suppressing confidence �� 0.25 and status �� cooling_after_repair.
                # This broke the thermalization cycle: cooled defect (conf < 0.42)
                # cannot re-thermalize when counterfactuals fail to break oscillation,
                # so the L6 repair pipeline never re-fires.
                # Fix: compare current stagnation against RESTING_STATE (still holds
                # previous tick's value �� current tick's value is in local `stagnation`
                # and will be written to RESTING_STATE later in the outer tick loop).
                prev_stag = int(RESTING_STATE.get("stagnation_streak", 0) or 0)
                curr_stag = int(observation.get("stagnation", stagnation) or stagnation or 0)
                stag_decreased = curr_stag < prev_stag
                evidence.append(
                    f"cooling_guard: prev_stag={prev_stag}, curr_stag={curr_stag}, "
                    f"decreased={stag_decreased}"
                )
                if stag_decreased:
                    rd["confidence"] = 0.25
                    rd["status"] = "cooling_after_repair"
                # else: stagnation did not decrease �� keep defect hot (status=None)
                # so the L6 repair pipeline can re-activate on the next cycle
                rd["evidence"] = evidence
                observation["residual_defect"] = rd

    jepa_sample = _append_ego_jepa_buffer(
        tick=tick,
        ego_state=ego_state,
        observation=observation,
        affordances=affordances,
    )

    existing = RESTING_STATE.get("external_evidence", {})
    existing["workspace_observation"] = observation
    RESTING_STATE["external_evidence"] = existing
    ttl = RESTING_STATE.get("evidence_persist_ticks", 5)
    ttl_dict = RESTING_STATE.get("evidence_ttl", {})
    ttl_dict["workspace_observation"] = ttl
    RESTING_STATE["evidence_ttl"] = ttl_dict
    RESTING_STATE["last_workspace_observation"] = observation
    RESTING_STATE["last_workspace_observation_tick"] = tick

    entry["action_gateway"] = {
        "mode": "observe_workspace",
        "count": observation.get("count", 0),
        "summary": observation.get("summary", ""),
        "affordances": observation.get("affordances", []),
    }
    _write_consumption_log({
        "event": "workspace_observed",
        "tick": tick,
        "source": "action_gateway",
        "dominant": dominant,
        "competition": round(competition, 3),
        "stagnation_streak": stagnation,
        "count": observation.get("count", 0),
        "summary": observation.get("summary", ""),
        "top_affordance": (observation.get("jepa") or {}).get("top_affordance"),
        "top_score": (observation.get("jepa") or {}).get("top_score"),
        "top_predicted_outcome": affordances[0].get("predicted_outcome") if affordances else None,
        "jepa_buffer_status": jepa_sample.get("status") if jepa_sample else None,
    })
    print(f"[action-gateway] workspace observed: {observation.get('summary', '')}", flush=True)
    jepa_outcome = _reconcile_jepa_predictions(tick=tick, observation=observation)
    if jepa_outcome:
        observation["jepa_reconcile"] = jepa_outcome
    return observation


