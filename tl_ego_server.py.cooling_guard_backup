# ─── Titan Stage 1: JEPA Prediction Reconciliation ───
def _reconcile_jepa_predictions(*, tick: int, observation: dict):
    """When workspace_observation comes in after an action, update the most
    recent pending JEPA buffer entry with actual outcome data. This closes
    the prediction->observation feedback loop so the heuristic can be
    calibrated from real-world results instead of staying on heuristics alone."""
    try:
        path = str(EGO_JEPA_BUFFER_LOG)
        if not path or not Path(path).exists():
            return
        entries = []
        with open(path, "r", encoding="utf-8") as f:
            for ln in f:
                try: entries.append(json.loads(ln))
                except: pass
        if not entries:
            return
        pending = [e for e in entries if e.get("status") == "pending_outcome"]
        if not pending:
            return
        latest = pending[-1]
        actual = {
            "workspace_status": observation.get("status"),
            "change_count": observation.get("count", 0),
            "categories": observation.get("categories", {}),
            "summary": observation.get("summary", "")[:500],
        }
        latest["actual_state_t1"] = actual
        latest["observation_ts"] = time.strftime("%Y-%m-%d %H:%M:%S")
        predicted = latest.get("predicted_state_t1", {}) or {}
        pred_novelty = float(predicted.get("external_novelty", 0.5) or 0.5)
        actual_cats = len(actual.get("categories", {}))
        actual_novelty = jepa_observation_novelty(actual) if jepa_observation_novelty else actual_cats * 0.08
        pe = round(abs(pred_novelty - actual_novelty) / max(pred_novelty, 0.01), 3)
        pe = min(max(pe, 0.0), 1.0)
        latest["prediction_error"] = pe
        latest["status"] = "observed"
        # ── Bounded multi-sample observation window (L6-fix-v3) ──
        # Maintain at most 5 compact summaries (dominant/conc/comp/stag) so that
        # residual attribution can distinguish oscillation_lag from true prediction
        # failure.  Window is local-only and event-driven: updated each tick when a
        # workspace_observation arrives; no cron job, no external write.
        _jepa_win = RESTING_STATE.setdefault("_jepa_obs_window", [])
        _jepa_win.append({
            "tick": tick,
            "dominant": RESTING_STATE.get("last_dominant"),
            "concentration": RESTING_STATE.get("concentration", RESTING_STATE.get("last_concentration", 0.0)),
            "competition": RESTING_STATE.get("competition", RESTING_STATE.get("last_competition", 0.0)),
            "stagnation_streak": RESTING_STATE.get("stagnation_streak", 0),
        })
        if len(_jepa_win) > 30:
            _jepa_win[:] = _jepa_win[-30:]

        if _attribute_jepa_residual_and_append:
            try:
                attribution_context = dict(latest.get("state_t") or latest.get("ego_state_t0") or {})
                _dom_seq = [s["dominant"] for s in _jepa_win if s.get("dominant")] if len(_jepa_win) >= 5 else []
                recent_dominants = _dom_seq if _dom_seq else [
                    e.get("dominant") for e in RESTING_STATE.get("trajectory", [])[-5:]
                    if isinstance(e, dict) and e.get("dominant")
                ]
                attribution_context.update({
                    "tick": tick,
                    "competition": attribution_context.get("competition", RESTING_STATE.get("competition", RESTING_STATE.get("last_competition", 0.0))),
                    "concentration": attribution_context.get("concentration", RESTING_STATE.get("concentration", RESTING_STATE.get("last_concentration", 0.0))),
                    "stagnation": attribution_context.get("stagnation_streak", RESTING_STATE.get("stagnation_streak", 0)),
                    "stagnation_streak": attribution_context.get("stagnation_streak", RESTING_STATE.get("stagnation_streak", 0)),
                    "recent_dominants": recent_dominants,
                    "reported_prediction_error": pe,
                    "jepa_score": latest.get("jepa_score"),
                    "workspace_change_count": actual.get("change_count", 0),
                })
                # Enrich context with multi-sample window summary (≥3 samples).
                if len(_jepa_win) >= 3:
                    _dom_seq = [s["dominant"] for s in _jepa_win if s.get("dominant")]
                    _c_vals = [s.get("concentration", 0.0) for s in _jepa_win]
                    _k_vals = [s.get("competition", 0.0) for s in _jepa_win]
                    _dom_ct = Counter(d for d in _dom_seq if d != "unknown")
                    _n_dom = len(_dom_ct)
                    _tot = len(_dom_seq) or 1
                    _mfrac = max(_dom_ct.values()) / _tot if _dom_ct else 1.0
                    attribution_context["_multi_sample_window"] = {
                        "window_size": len(_jepa_win),
                        "window_unique_dominant_types": _n_dom,
                        "window_dominant_type_counts": dict(_dom_ct),
                        "window_conc_range": [round(min(_c_vals), 4), round(max(_c_vals), 4)],
                        "window_comp_range": [round(min(_k_vals), 4), round(max(_k_vals), 4)],
                        "window_dominant_mode": "oscillating" if _n_dom >= 2 else ("stable" if _n_dom == 1 else "mixed"),
                        "window_predicted_actual_mismatch_ratio": round(1.0 - _mfrac, 3),
                    }
                actual_for_attribution = dict(actual)
                actual_for_attribution.update({
                    "dominant": RESTING_STATE.get("last_dominant"),
                    "concentration": RESTING_STATE.get("concentration", RESTING_STATE.get("last_concentration", 0.0)),
                    "competition": RESTING_STATE.get("competition", RESTING_STATE.get("last_competition", 0.0)),
                    "stagnation": RESTING_STATE.get("stagnation_streak", 0),
                    "external_novelty": round(actual_cats * 0.08, 3),
                })
                action_t = latest.get("action_t") if isinstance(latest.get("action_t"), dict) else {}
                action_name = (
                    action_t.get("name")
                    or latest.get("action_type")
                    or latest.get("top_affordance")
                    or "workspace_observation"
                )
                _attribute_jepa_residual_and_append(
                    predicted=predicted,
                    actual=actual_for_attribution,
                    context=attribution_context,
                    action=action_name,
                    tick=tick,
                )
            except Exception as e:
                print(f"[jepa-residual] attribution error: {e}", flush=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(latest, ensure_ascii=False) + "\n")
        print(f"[jepa-reconcile] tick={tick} pe={pe:.3f} status=observed", flush=True)
        return {
            "source": "jepa_reconcile_workspace_observation",
            "prediction_error_source": "ego_jepa_buffer_reconcile",
            "prediction_error": pe,
            "expected_result": latest.get("predicted_state_t1"),
            "actual_result": actual,
            "task_id": latest.get("task_id") or f"jepa_reconcile_{tick}",
            "action_type": latest.get("action_type") or latest.get("top_affordance") or "workspace_observation",
            "outcome": "observed",
            "state_before": latest.get("ego_state_t0"),
            "state_after": actual,
            "stdp_boost_factor": 1.0,
        }
    except Exception as e:
        print(f"[jepa-reconcile] error: {e}", flush=True)
        return None



