HINT_KEYWORD_MAP = {
    "calibration": "sensory_explore",
    "calibrate": "sensory_explore",
    "jepa": "sensory_explore",
    "stagnation": "deep_probe_unstable",
    "break_stagnation": "deep_probe_unstable",
