    ttr_advice = _load_ttr_resting_advice()
    if ttr_advice:
        ttr_mult = float(ttr_advice.get("resting_stdp_mult", 1.0) or 1.0)
        ttr_mult = max(0.85, min(1.15, ttr_mult))
        stdp_mult *= ttr_mult
        RESTING_STATE["ttr"] = {
            "coherence": ttr_advice.get("coherence"),
            "semantic_heat": ttr_advice.get("semantic_heat"),
            "plasticity": ttr_advice.get("plasticity"),
            "anneal_advice": ttr_advice.get("anneal_advice"),
            "stdp_mult": round(ttr_mult, 4),
        }
        print(
            f"[ttr] resting advice: {ttr_advice.get('anneal_advice')} "
            f"heat={ttr_advice.get('semantic_heat')} mult={ttr_mult:.3f}",
            flush=True,
        )
    else:
        RESTING_STATE.pop("ttr", None)

    activation_path = result.get("activation_path", [])
    synaptogenesis_new_edges = 0
    if len(activation_path) >= 2:
        old_ap, old_am = A_PLUS, A_MINUS
        A_PLUS *= stdp_mult
        A_MINUS *= stdp_mult
        try:
            apply_stdp(activation_path)
        finally:
            A_PLUS, A_MINUS = old_ap, old_am
        try:
            synaptogenesis_new_edges = _synaptogenesis_update(activation_path)
        except Exception as _syn_e:
            print(f"[synaptogenesis] error: {_syn_e}", flush=True)
    if synaptogenesis_new_edges:
        entry["synaptogenesis"] = {
            "new_edges": synaptogenesis_new_edges,
            "total_new_edges": SYNAPTOGENESIS_TOTAL_NEW_EDGES,
            "window": SYNAPTOGENESIS_WINDOW,
            "min_rate": SYNAPTOGENESIS_MIN_RATE,
        }
        print(f"[synaptogenesis] grew {synaptogenesis_new_edges} weak edge(s) "
              f"(total={SYNAPTOGENESIS_TOTAL_NEW_EDGES})", flush=True)

    # ── 5. Store seeds for next tick -- adaptive alpha (v3.4) ──
    # Keep more seeds during consolidate, fewer during burst
    # §25: Use evolved alpha if available
    _evolved_alpha = RESTING_STATE.get("evolved_alpha")
    if phase_name == "burst":
        ALPHA = 0.2   # mostly replaced -- jump to new basin
    elif phase_name == "consolidate":
        pass  # ALPHA set by shared integration_pressure guard below
    else:
        pass  # ALPHA set by shared integration_pressure guard below
    # §36 (2026-06-24): Integration pressure guard covers BOTH consolidate and explore.
    # Previously only covered `else` (explore), so consolidate with integration_pressure=True
    # always used ALPHA=0.7, overwriting integrator-biased seeds at the 30% random-mix boundary.
    # §36-B: Raised concentration threshold from 0.70 to 0.85. At conc=0.77/comp=0.76 the old
    # guard evaluated False (conc 0.77 > 0.70), letting mixer overwrite integrator-biased seeds.
    if phase_name != "burst":
        # §39 (2026-06-26): Use _integration_pressure (shared with heater guard) instead of
        # stale _fresh_int_drive. When integration_pressure is True, ALPHA=1.0 preserves
        # all integrator-favored seeds from contemplation (mixer replaces 0/10 seeds).
        # When integration_pressure is False, ALPHA=0.5 (or evolved_alpha) allows moderate diversity.
        if _integration_pressure:
            ALPHA = 1.0
        else:
            ALPHA = _evolved_alpha if _evolved_alpha is not None else 0.5
    else:
        ALPHA = 0.2  # burst


    new_seeds = result["final_state_top10"]
    n_keep = max(1, int(len(new_seeds) * ALPHA))
    mixed = list(new_seeds[:n_keep])
    for _ in range(len(new_seeds) - n_keep):
        t = random.choice(TYPE_NAMES)
        typed = [nid for nid, nt in NEURON_TYPE.items() if nt == t]
        if typed:
            mixed.append(random.choice(typed))
    # §40 (2026-06-26): Integration-pressure seed demotion.
    # (last_seeds moved to AFTER §42 promotion — was L6857, before demotion+promotion made it a no-op)
    # When _integration_pressure=True and ALPHA=1.0 preserved all attractor seeds,
    # action-dominant top10 reinforces the action->action edge basin indefinitely.
    # Demote ~1/3 of action-type seeds to break the cycle without affecting
    # normal (guard=False) operation, which uses ALPHA=0.5 with active mixer.
    if _integration_pressure and ALPHA >= 0.95:
        _action_seed_idxs = [i for i, nid in enumerate(mixed) if parse_type(nid) == 'action']
        if len(_action_seed_idxs) > 2:
            n_demote = max(1, len(_action_seed_idxs) // 3)
            demote_idxs = random.sample(_action_seed_idxs, n_demote)
            # Bug3-fix (2026-06-27): Prefer integrator as demotion target when integration_pressure.
            # Old: random.choice(_non_action_types) gives ~25% integrator chance, wasting demotion slots.
            # New: bias toward integrator directly; fallback to random only if no integrator neurons exist.
            _integrator_neurons = [nid for nid, nt in NEURON_TYPE.items() if nt == 'integrator']
            for di in demote_idxs:
                if _integration_pressure and _integrator_neurons:
                    mixed[di] = random.choice(_integrator_neurons)
                else:
                    _non_action_types = [t for t in TYPE_NAMES if t != 'action']
                    t = random.choice(_non_action_types)
                    typed_neurons = [nid for nid, nt in NEURON_TYPE.items() if nt == t]
                    if typed_neurons:
                        mixed[di] = random.choice(typed_neurons)
    # §42 (2026-06-26): Integration-pressure integrator promotion.
    # Symmetric counterpart to the action demotion above: when integration_pressure
    # is True and the attractor fell to a non-integrator basin, promote 1-2
    # integrator-type neurons into final_state_top10 so the next tick's seeds
    # are not 100% non-integrator. Without this, ALPHA=1.0 preserves all-memory
    # seeds indefinitely (demotion removes action seeds but does not add integrator).
    if _integration_pressure and ALPHA >= 0.95:
        _int_count = sum(1 for nid in new_seeds if parse_type(nid) == "integrator")
        if _int_count < 2:
            # Under-represented (< 2/10 seeds): promote 1-2 highest-activation integrator neurons.
            # action_demote may inject 1 integrator by random chance; _int_count==1 must not block this.
            # Source: full attractor result (before STDP-modified activation_path).
            _cand_int = sorted(
                [(nid, result.get("activation_scores", {}).get(nid, 0))
                 for nid, nt in NEURON_TYPE.items() if nt == "integrator"],
                key=lambda x: -x[1]
            )
            if _cand_int:
                # Replace 1-2 lowest-activation non-integrator seeds
                _non_int_idx = [i for i, nid in enumerate(new_seeds)
                                if parse_type(nid) != "integrator"]
                n_promote = min(2, len(_non_int_idx), len(_cand_int))
                if n_promote > 0:
                    promote_idxs = sorted(_non_int_idx[-n_promote:])
                    for pi, ci in zip(promote_idxs, _cand_int[:n_promote]):
                        new_seeds[pi] = ci[0]
                    print(f"[integrator_promote] promoted {n_promote} integrator neuron(s) "
                          f"into final_state_top10 (was {_int_count}/10)", flush=True)
    RESTING_STATE["last_seeds"] = mixed[:len(new_seeds)]
    if RESTING_STATE.get("ttr"):
        result["ttr"] = RESTING_STATE["ttr"]

    # P2: Metacontemplate automation -- every 20 resting ticks, trigger self-reflection
    RESTING_STATE["tick"] += 1
    # P5: Update persistent identity -- track cumulative dominant type
    try:
        _dom_t = result["dominant"]
        if _dom_t not in ("unknown", "?"):
            _hist = RESTING_STATE.setdefault("dominant_history", {})
            _hist[_dom_t] = _hist.get(_dom_t, 0) + 1
            _total = sum(_hist.values())
            if _total >= 10:
                _top_type = max(_hist, key=_hist.get)
                _conf = _hist[_top_type] / _total
                global PERSISTENT_IDENTITY
                PERSISTENT_IDENTITY = {
                    "dominant_type": _top_type,
                    "dominant_ticks": _hist[_top_type],
                    "total_ticks": _total,
                    "confidence": round(_conf, 4),
                    "last_updated_tick": RESTING_STATE["tick"],
                    "profile": dict(sorted(_hist.items(), key=lambda x: -x[1])),  # show all 8 types
                }
                if _total % 50 == 0:
                    print(f"[identity] persistent: {_top_type} @ {_conf:.1%} over {_total} ticks", flush=True)
    except Exception:
        pass
    if RESTING_STATE["tick"] % 20 == 0:
        try:
            import threading as _th
            print(f"[meta] Auto metacontemplate trigger at tick {RESTING_STATE['tick']}", flush=True)
            _th.Thread(target=_auto_metacontemplate, daemon=True).start()
        except Exception as _e:
            print(f"[meta] Auto trigger error: {_e}", flush=True)

    # ── 6. S5 Causal-Lens bridge: trajectory + self-model -> causal_gap ──
    try:
        _traj_raw = RESTING_STATE.get("trajectory", [])
        with open(WORKSPACE / "_s5_debug.log", "a", encoding="utf-8") as _df:
            _df.write(f"[s5] tick={RESTING_STATE.get('tick','?')} traj_len={len(_traj_raw)}\n")
