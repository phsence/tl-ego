_LAE_CLEANUP_PATTERNS = ("*.bat", "*.cmd", "*.tmp", "*.ps1")  # temp scripts
_LAE_CLEANUP_PREFIXES = ("_ct_", "_fb_", "_write_", "_mc_", "_usm_", "_p0_",
                         "_start_", "_test_", "_tmp_", "_wait_", "_append_",
                         "_check_", "_fix_", "_verify_", "_bridge_",
