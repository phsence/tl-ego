def _imagine_alternatives_handler():
    """L8 Imagination: simulate alternate decision trajectories using
    TYPE_TRANSITION_PRIORS + JEPA predictor.

    Called from _externalize_autonomy_impulse when resolve_tool returns
    imagine_alternatives. No subagent needed — pure internal simulation.
    Results go to RESTING_STATE["_imagined_trajectories"] for metacontemplate.
    Returns True if virtual trajectories were generated, False otherwise.
    """
    try:
        global _L8_STATUS
        _traj = RESTING_STATE.get("trajectory", [])
        _recent = _traj[-30:] if len(_traj) > 30 else _traj
        _tick = RESTING_STATE.get("tick", 0)
        _comp = RESTING_STATE.get("competition", 0.5)
        _conc = RESTING_STATE.get("concentration", 0.5)
        _dominant = RESTING_STATE.get("last_dominant", "unknown")

        if len(_recent) < 3:
            _L8_STATUS["last_imagination"] = {
                "branches": 0,
                "dominant": _dominant,
                "reason": "trajectory too short (<3 entries)",
                "real_tool": None,
                "avg_divergence": 0,
                "switches": 0,
                "branch_tools": [],
            }
            _L8_STATUS["last_imagination_tick"] = _tick
            return False

        # Count type_switches from recent trajectory as diversity signal
        _prev = None
        _switches = 0
        for _e in _recent:
            _cur = _e.get("dominant", "")
            if _prev is not None and _cur and _cur != _prev:
                _switches += 1
            _prev = _cur

        # Known type set for transition priors
        _all_types = ["sensory", "memory", "action", "integrator", "decider", "rule_modification"]

        # Branch: choose 3-5 alternate tools that differ from the real trajectory
        _branches = []
        _branch_tools = []
        # Resolve current state's tool and pick 3 alternatives
        try:
            from tools_registry import resolve_tool, TOOLS as _TOOLS
            _real_tool_name, _ = resolve_tool(RESTING_STATE)
        except Exception:
            _real_tool_name = "spontaneous_action"

        _real_only = {_real_tool_name}
        _candidates = [t for t in _all_types if t != _dominant]
        import random as _random
        _random.shuffle(_candidates)
        for _alt_type in _candidates[:3]:
            _alt_name = f"neuron_{_alt_type}_execute"
            if _alt_name not in _real_only:
                _branch_tools.append(_alt_name)
                _real_only.add(_alt_name)
        if len(_branch_tools) < 2:
            _branch_tools.append("explore_external")

        # For each branch tool, simulate expected outcome using transition priors
        _TYPE_TRANSITION_PRIORS = RESTING_STATE.get("_type_transition_priors", {})
        for _bt in _branch_tools:
            # Compute expected dominant sequence: current dominant * transition_prior(tool_type)
            _sim_seq = [_dominant]
            _div = 0.0
            for _vt in range(3):  # 3 virtual ticks
                _last = _sim_seq[-1]
                _row = _TYPE_TRANSITION_PRIORS.get(_bt, {}).get(_last, {})
                if not _row:
                    # Fallback: uniform transition
                    _next = _random.choice(_all_types)
                    _prob = 1.0 / len(_all_types)
                else:
                    _next = max(_row, key=_row.get)
                    _prob = _row.get(_next, 0.5)
                _sim_seq.append(_next)
                if _vt > 0 and _next != _sim_seq[-2]:
                    _div += (1.0 - _prob)

            _branches.append({
                "branch_tool": _bt,
                "virtual_sequence": _sim_seq,
                "divergence_score": round(_div / max(1, len(_sim_seq)), 4),
                "simulated_ticks": len(_sim_seq) - 1,
            })

        # Also produce one "what-if-contrary" branch: pick the opposite of current dominant
        _opposite_types = [t for t in _all_types if t != _dominant]
        _random.shuffle(_opposite_types)
        _contrary_tool = f"neuron_{_opposite_types[0]}_execute"
        _contrary_seq = [_dominant]
        for _vt in range(3):
            _last = _contrary_seq[-1]
            _row = _TYPE_TRANSITION_PRIORS.get(_contrary_tool, {}).get(_last, {})
            if not _row:
                _next = _random.choice([t for t in _all_types if t != _last])
                _prob = 0.3
            else:
                _next = max(_row, key=_row.get)
                _prob = _row.get(_next, 0.3)
            _contrary_seq.append(_next)
        _branches.append({
            "branch_tool": _contrary_tool,
            "virtual_sequence": _contrary_seq,
            "divergence_score": round(0.5 + _random.random() * 0.3, 4),
            "simulated_ticks": 3,
            "contrary": True,
        })

        # Store in RESTING_STATE for metacontemplate consumption
        RESTING_STATE["_imagined_trajectories"] = {
            "tick": _tick,
            "branches": _branches,
            "total_branches": len(_branches),
            "real_dominant": _dominant,
            "real_tool": _real_tool_name,
            "avg_divergence": round(
                sum(b.get("divergence_score", 0) for b in _branches) / max(1, len(_branches)),
                4
            ),
        }
        RESTING_STATE["_l8_imagine_tick"] = _tick

        # Write autonomy evidence
        _evid_path = EVIDENCE_PATHS.get("autonomy_evidence")
        if _evid_path:
            _evid_path.write_text(json.dumps({
                "action": "imagine_alternatives",
                "title": f"L8 imagination: {len(_branches)} virtual branches simulated",
                "domain": "integrator",
                "reason": f"imagined alternatives from dominant={_dominant}, switches={_switches}",
                "tick": _tick,
                "source": "ego_autonomy_generated",
                "n_branches": len(_branches),
            }, indent=2) + "\n", encoding="utf-8")

        _L8_STATUS["last_imagination"] = {
            "branches": len(_branches),
            "dominant": _dominant,
            "real_tool": _real_tool_name,
            "avg_divergence": RESTING_STATE["_imagined_trajectories"]["avg_divergence"] if RESTING_STATE.get("_imagined_trajectories") else 0,
            "switches": _switches,
            "branch_tools": _branch_tools,
        }
        _L8_STATUS["last_imagination_tick"] = _tick
        print(f"[l8-imagine] {len(_branches)} branches simulated from {_dominant} (switches={_switches})", flush=True)
        return len(_branches) > 0
    except Exception as _e:
        print(f"[l8-imagine] failed: {_e}", flush=True)
        import traceback
        traceback.print_exc()
        return False


def _curiosity_gap_handler():
    """L8 Curiosity: build knowledge gap map from low-confidence RDF triples
    + trajectory novelty holes. Compute expected information gain per gap.

    Called from _externalize_autonomy_impulse when resolve_tool returns
    curiosity_gap_analysis. No subagent — reads MemoryBus directly.
    Results go to RESTING_STATE["_curiosity_gaps"] for metacontemplate.
    Returns True if gaps were found, False otherwise.
    """
    try:
        global _L8_STATUS
        import random as _random
        _tick = RESTING_STATE.get("tick", 0)
        _dominant = RESTING_STATE.get("last_dominant", "unknown")
        _traj = RESTING_STATE.get("trajectory", [])
        _recent = _traj[-30:] if len(_traj) > 30 else _traj
        _stagnation = RESTING_STATE.get("stagnation_streak", 0)

        _gaps = []

        # Gap source 1: RDF low-confidence triples via MemoryBus
        _mb_gaps = False
        try:
            if _MEMORY_BUS_BRIDGE and hasattr(_MEMORY_BUS_BRIDGE, 'hybrid_search'):
                _mb_results = _MEMORY_BUS_BRIDGE.hybrid_search(f"low confidence uncertainty gap", top_k=5)
                if _mb_results:
                    _gaps.append({
                        "gap_id": "rdf_low_confidence",
                        "domain": "rdf",
                        "gain": round(0.5 + 0.5 * min(1.0, len(_mb_results) / 10.0), 4),
                        "action_hint": "query_memorybus",
                        "source": "MemoryBus hybrid search found ambiguous entries",
                        "n_found": len(_mb_results),
                    })
                    _mb_gaps = True
        except Exception as _rdf_e:
            print(f"[l8-curiosity] RDF gap scan failed: {_rdf_e}", flush=True)

        # Gap source 2: trajectory novelty holes — never-seen-before type/state combinations
        _seen_combos = set()
        for _e in _traj:
            _d = _e.get("dominant", "")
            _c = round(float(_e.get("competition", 0)), 2)
            _cc = round(float(_e.get("concentration", 0)), 2)
            _seen_combos.add((_d, _c, _cc))

        _all_types = ["sensory", "memory", "action", "integrator", "decider", "rule_modification"]
        _comp_levels = [round(i * 0.25, 2) for i in range(5)]
        _conc_levels = [round(i * 0.25, 2) for i in range(5)]
        _novel_count = 0
        for _t in _all_types:
            for _cl in _comp_levels:
                for _cc in _conc_levels:
                    if (_t, _cl, _cc) not in _seen_combos:
                        _novel_count += 1
                        if _novel_count <= 3:  # top 3 novel combos
                            _gaps.append({
                                "gap_id": f"novel_type_combo_{_t}_{_cl}_{_cc}",
                                "domain": "trajectory",
                                "gain": round(0.3 + _random.random() * 0.4, 4),
                                "action_hint": "imagine_alternatives" if _t != _dominant else "curiosity_explore",
                                "source": f"never seen dominant={_t} with comp={_cl} conc={_cc}",
                            })

        # Gap source 3: meta-cognitive — stagnation + high competition without deep analysis
        if _stagnation >= 2:
            _gaps.append({
                "gap_id": "stagnation_without_deep_analysis",
                "domain": "meta",
                "gain": round(0.6 + min(0.3, _stagnation * 0.05), 4),
                "action_hint": "synthesize_novel_concept",
                "source": f"stagnation streak={_stagnation} without a novel mechanism attempt",
            })

        # Sort by gain descending and store top-k
        _gaps.sort(key=lambda g: g.get("gain", 0), reverse=True)
        _top_gaps = _gaps[:5]

        RESTING_STATE["_curiosity_gaps"] = _top_gaps
        RESTING_STATE["_l8_gap_map_tick"] = _tick

        # Write autonomy evidence
        _evid_path = EVIDENCE_PATHS.get("autonomy_evidence")
        if _evid_path:
            _evid_path.write_text(json.dumps({
                "action": "curiosity_gap_analysis",
                "title": f"L8 curiosity gap map: {len(_top_gaps)} gaps found",
                "domain": "memory",
                "reason": f"{len(_top_gaps)} knowledge gaps from RDF + trajectory + meta sources",
                "tick": _tick,
                "source": "ego_autonomy_generated",
                "n_gaps": len(_top_gaps),
                "top_gain": _top_gaps[0]["gain"] if _top_gaps else 0,
            }, indent=2) + "\n", encoding="utf-8")

        _L8_STATUS["last_curiosity"] = {
            "n_gaps": len(_top_gaps),
            "top_gaps": [{"id": g["gap_id"], "domain": g["domain"], "gain": g["gain"], "hint": g["action_hint"]} for g in _top_gaps[:3]],
            "dominant": _dominant,
            "stagnation": _stagnation,
        }
        _L8_STATUS["last_curiosity_tick"] = _tick
        print(f"[l8-curiosity] {len(_top_gaps)} knowledge gaps found (top gain={_top_gaps[0]['gain']:.3f})", flush=True) if _top_gaps else print("[l8-curiosity] no gaps found", flush=True)
        return len(_top_gaps) > 0
    except Exception as _e:
        print(f"[l8-curiosity] failed: {_e}", flush=True)
        import traceback
        traceback.print_exc()
        return False


def _synthesize_novel_handler():
    """L8 Creativity: generate a novel code-level mechanism proposal when
    existing tools cannot resolve a persistent knowledge gap or defect.

    Called from _externalize_autonomy_impulse when resolve_tool returns
    synthesize_novel_concept. Writes proposal to sandbox for review.
    Returns True if synthesis was generated, False otherwise.
    """
    try:
        global _L8_STATUS
        _tick = RESTING_STATE.get("tick", 0)
        _dominant = RESTING_STATE.get("last_dominant", "unknown")
        _stagnation = RESTING_STATE.get("stagnation_streak", 0)
        _competition = RESTING_STATE.get("competition", 0.5)
        _concentration = RESTING_STATE.get("concentration", 0.5)
        _gaps = RESTING_STATE.get("_curiosity_gaps", [])

        # Problem formulation: pick the best signal for a novel mechanism
        _problems = []

        # Check recurring L6 defects
        _l6_log = WORKSPACE / ".lae" / "l6_residual_log.jsonl"
        if _l6_log.exists():
            try:
                _lines = _l6_log.read_text("utf-8").strip().split("\n")
                _recent_defects = [json.loads(l) for l in _lines[-10:]]
                # Count recurring defect types
                _defect_counts = {}
                for _d in _recent_defects:
                    _dt = _d.get("defect_type", "unknown")
                    _defect_counts[_dt] = _defect_counts.get(_dt, 0) + 1
                _persistent = [(k, v) for k, v in _defect_counts.items() if v >= 2]
                for _dt, _cnt in _persistent:
                    _problems.append({
                        "type": "recurring_defect",
                        "label": _dt,
                        "count": _cnt,
                        "severity": min(1.0, _cnt / 5.0),
                    })
            except Exception:
                pass

        # Check knowledge gaps that action_hint=synthesize_novel_concept
        for _g in _gaps:
            if _g.get("action_hint") == "synthesize_novel_concept":
                _problems.append({
                    "type": "knowledge_gap",
                    "label": _g.get("gap_id", "unknown_gap"),
                    "count": 1,
                    "severity": _g.get("gain", 0.5),
                })

        # If no concrete problem found, formulate from state
        if not _problems:
            _problems.append({
                "type": "state_anomaly",
                "label": f"{_dominant}_dominant_stag_{_stagnation}",
                "count": 1,
                "severity": min(1.0, (_stagnation + _competition) * 0.5),
            })

        # Pick the most severe problem
        _problem = max(_problems, key=lambda p: p["severity"])

        # Generate a named mechanism
        _sandbox_base = WORKSPACE / ".lae" / "l8_sandbox"
        _sandbox_base.mkdir(parents=True, exist_ok=True)
        _ts = datetime.now().strftime("%Y%m%d-%H%M%S")
        _sandbox_dir = _sandbox_base / f"l8g-{_ts}"
        _sandbox_dir.mkdir(parents=True, exist_ok=True)

        # Name this one candidate after its selected problem, then create several
        # deterministic, evidence-grounded hypotheses and select the most novel high-fit option.
        _mech_name = f"L8_{_problem['type'].replace(' ', '_')}_{_tick}"
        import hashlib as _hashlib
        _mech_id = _hashlib.md5(f"{_ts}_{_problem['label']}".encode()).hexdigest()[:12]
        # L8 proposes a diagnostic only; the existing verifier and L5 remain the promotion boundary.
        _previous_kinds = {
            item.get("hypothesis_kind")
            for item in RESTING_STATE.get("_l8_hypothesis_history", [])[-12:]
            if isinstance(item, dict) and item.get("hypothesis_kind")
        }
        _hypotheses = rank_mechanism_hypotheses(
            _problem,
            {
                "competition": _competition,
                "concentration": _concentration,
                "stagnation_streak": _stagnation,
                "type_switches": RESTING_STATE.get("type_switches", 0),
            },
            _previous_kinds,
        )
        _candidate_runs = []
        for _index, _candidate in enumerate(_hypotheses, start=1):
            _candidate_name = f"{_mech_name}_{_index}"
            _candidate_path = _sandbox_dir / f"{_candidate_name}.py"
            _candidate_code = render_diagnostic_mechanism(
                _candidate_name, _mech_id, _tick, _problem["label"], _candidate,
            )
            _candidate_path.write_text(_candidate_code, "utf-8")
            _candidate_verification = {
                "ok": False,
                "stage": "unavailable",
                "reason": "L8 sandbox verifier unavailable",
            }
            if _L8_SANDBOX_VERIFIER_AVAILABLE:
                _candidate_verification = verify_l8_proposal(
                    _candidate_path,
                    _candidate_name,
                    {
                        "competition": _competition,
                        "stagnation_streak": _stagnation,
                        "concentration": _concentration,
                        "dominant": _dominant,
                        "tick": _tick,
                    },
                )
            _candidate["sandbox_verification"] = _candidate_verification
            _candidate_runs.append({
                "mech_name": _candidate_name,
                "proposal_path": str(_candidate_path),
                "candidate": _candidate,
            })

        # Every alternative faces the isolated contract check before selection.
        # The selected result remains a review artifact, never a live import.
        _verified_runs = [
            _run for _run in _candidate_runs
            if _run["candidate"]["sandbox_verification"]["ok"]
        ]
        _selected_run = _verified_runs[0] if _verified_runs else _candidate_runs[0]
        _selected = _selected_run["candidate"]
        _mech_name = _selected_run["mech_name"]
        _proposal_path = Path(_selected_run["proposal_path"])
        _verification = _selected["sandbox_verification"]

        # Write manifest
        import time as _time
        _manifest = {
            "mech_id": _mech_id,
            "mech_name": _mech_name,
            "problem": _problem,
            "hypotheses": _hypotheses,
            "candidate_runs": _candidate_runs,
            "selected_hypothesis": _selected,
            "proposed_at_tick": _tick,
            "timestamp": _time.strftime("%Y-%m-%d %H:%M:%S"),
            "sandbox_path": str(_sandbox_dir),
            "verification_pending": False,
            "verification": _verification,
        }
        _promotion = write_l8_promotion_artifact(_sandbox_dir, _manifest, _verification) if _L8_SANDBOX_VERIFIER_AVAILABLE else None
        _manifest["promotion"] = _promotion
        (_sandbox_dir / "manifest.json").write_text(json.dumps(_manifest, ensure_ascii=False, indent=2), "utf-8")

        RESTING_STATE.setdefault("_l8_hypothesis_history", []).append({
            "tick": _tick,
            "problem": _problem["label"],
            "hypothesis_kind": _selected["kind"],
            "score": _selected["score"],
        })
        RESTING_STATE["_l8_hypothesis_history"] = RESTING_STATE["_l8_hypothesis_history"][-20:]
        RESTING_STATE["_l8_synthesis_result"] = _manifest
        RESTING_STATE["_l8_synthesis_tick"] = _tick

        # Write autonomy evidence
        _evid_path = EVIDENCE_PATHS.get("autonomy_evidence")
        if _evid_path:
            _evid_path.write_text(json.dumps({
                "action": "synthesize_novel_concept",
                "title": f"L8 synthesis: {_mech_name} proposed for {_problem['label']}",
                "domain": "rule_modification",
                "reason": f"novel mechanism for {_problem['type']}: {_problem['label']}",
                "tick": _tick,
                "source": "ego_autonomy_generated",
                "mech_id": _mech_id,
                "hypothesis_kind": _selected["kind"],
                "hypotheses_considered": len(_hypotheses),
                "hypotheses_verified": len(_verified_runs),
                "selected_score": _selected["score"],
                "sandbox_path": str(_sandbox_dir),
                "verification_ok": _verification["ok"],
                "promotion_status": (_promotion or {}).get("status", "verification_unavailable"),
            }, indent=2) + "\n", encoding="utf-8")

        _L8_STATUS["last_synthesis"] = {
            "mech_name": _mech_name,
            "mech_id": _mech_id,
            "problem": _problem,
            "hypotheses": _hypotheses,
            "candidate_runs": _candidate_runs,
            "selected_hypothesis": _selected,
            "sandbox": str(_sandbox_dir),
            "verification": _verification,
            "promotion_status": (_promotion or {}).get("status", "verification_unavailable"),
            "dominant": _dominant,
        }
        _L8_STATUS["last_synthesis_tick"] = _tick
        print(f"[l8-synthesis] {_mech_name} proposed in {_sandbox_dir} (problem={_problem['label']})", flush=True)
        return True
    except Exception as _e:
        print(f"[l8-synthesis] failed: {_e}", flush=True)
        import traceback
        traceback.print_exc()
        return False


def _externalize_autonomy_impulse():
    """Externalize TL-Ego autonomy impulse as L5 bridge + autonomy evidence.

    Restored externalization chain (2026-06-11):
      - When internal impulse fires (Rule 4, stagnation>=8, high competition),
        writes .l5_bridge.json for the TL-Ego plugin's watcher to consume.
      - Also writes ego_autonomy_evidence.json for the evidence loop.
      - Plugin spawns a subagent, which can take external action (write files,
        call tools, etc.)

    Called from _resting_tick_impl() AFTER _generate_ego_evidence().
    """
    state = RESTING_STATE
    dominant = state.get("last_dominant", "unknown")
    stagnation = state.get("stagnation_streak", 0)
    tick = state.get("tick", 0)
    phase = state.get("noise_schedule", "explore")
    competition = state.get("competition", state.get("recent_kwta", {}).get("competition", 0.5))
    concentration = state.get("concentration", 0.5)
    prediction_error = state.get("last_prediction_error", 0.5)

    traj = state.get("trajectory", [])
    recent = traj[-60:] if len(traj) > 60 else traj  # L5g-20260711-000041: 60-tick window captures bistable oscillation
    type_switches = 0
    prev_type = None
    for entry in recent:
        cur = entry.get("dominant", "")
        if prev_type is not None and cur and cur != prev_type:
            type_switches += 1
        prev_type = cur

    integrator_pressure_ticks = 0
    integrator_near_wins = 0
    # §49b (2026-06-27 fix-2): Full-window scan, no reset-index.
    # The prior fix zeroed the counter whenever integrator appeared in the window,
    # then only counted entries AFTER the last integrator surface. In oscillation
    # regimes (type_switches >= 5), the post-surface window is almost always empty
    # (1 entry in a 20-tick window with 13 switches), so integrator_suppressed
    # always stays False. Fix: scan all entries in the window, excluding entries
    # where integrator is dominant. Integrator entries are still excluded from both
    # counts, preventing double-counting of genuine post-emergence pressure.
    for entry in recent:
        # Bugfix (l5g-20260703-000061): dominant integrator with low conc + high comp
        # is genuine pressure. Old code skipped it, pressure_ticks stayed 0 while integrator
        # was dominant, and integrator_suppressed never fired.
        if entry.get("dominant") == "integrator":
            _conc = float(entry.get("concentration", 0.5) or 0.5)
            _comp = float(entry.get("competition", 0.5) or 0.5)
            if _comp >= 0.70:
                integrator_pressure_ticks += 1
                integrator_near_wins += 1
            continue
        type_counts = entry.get("type_counts", {}) or {}
        integrator_count = type_counts.get("integrator", 0)
        if integrator_count <= 0:
            continue
        top_count = max(type_counts.values()) if type_counts else 0
        if top_count <= 0:
            continue
        integrator_share = integrator_count / top_count
        if integrator_share >= 0.5:
            integrator_pressure_ticks += 1
        if integrator_share >= 0.65:
            integrator_near_wins += 1

    integrator_suppressed = (
        integrator_pressure_ticks >= 2
        and integrator_near_wins >= 1
        and tick > 30
    )

    latest_counts = {}
    if traj:
        latest_counts = traj[-1].get("type_counts", {}) or {}
    active_types = sum(1 for count in latest_counts.values() if count > 0)

    emergence_pressure = competition >= 0.93 and concentration <= 0.50
    multi_attractor = active_types >= 4 or type_switches >= 5
    strong_emergence = emergence_pressure and multi_attractor and (
        stagnation >= 5 or phase == "burst" or type_switches >= 5
    )

    # L5-B: confident execution channel.
    # The original L5 bridge only externalized rescue/intervention impulses. A
    # high-confidence agreement from contemplation is a different signal: it is
    # safe to externalize only when the agreed state is actually action-bearing,
    # not when Ego is merely recalling or integrating memory.
    recent_context = CONTEXT_MEMORY[-3:] if len(CONTEXT_MEMORY) >= 3 else CONTEXT_MEMORY[:]
    latest_context = recent_context[-1] if recent_context else {}
    action_types = {"action", "decider"}
    latest_actionable = (
        latest_context.get("s1_type") in action_types
        or latest_context.get("s2_type") in action_types
        or latest_context.get("alignment_axis") in {"choice_to_action", "action_to_choice", "evidence_to_choice", "recall_to_action", "synthesis_to_action"}
    )
    latest_high_agree = (
        latest_context.get("verdict") == "high_confidence_agree"
        and bool(latest_context.get("compatible_agreement", latest_context.get("agreement", False)))
        and float(latest_context.get("confidence", 0.0) or 0.0) >= 0.35
    )
    stable_high_agree_count = sum(
        1 for item in recent_context
        if item.get("verdict") == "high_confidence_agree"
        and bool(item.get("compatible_agreement", item.get("agreement", False)))
        and (
            item.get("s1_type") in action_types
            or item.get("s2_type") in action_types
            or item.get("alignment_axis") in {"choice_to_action", "action_to_choice", "evidence_to_choice", "recall_to_action", "synthesis_to_action"}
        )
    )
    confident_execution = latest_high_agree and latest_actionable and stable_high_agree_count >= 1

    # ── Decide whether to externalize ──
    should_externalize = False
    externalize_reason = ""

    # Condition A: Deep stagnation (urgent escape needed)
    if stagnation >= 12 and (competition >= 0.85 or phase == "burst"):
        should_externalize = True
        externalize_reason = f"deep stagnation={stagnation}, competition={competition:.3f}, need external intervention"

    # Condition B: Strong emergence: high competition, diffuse activation, multi-attractor pressure
    elif strong_emergence and stagnation >= 5:
        should_externalize = True
        externalize_reason = (
            f"strong emergence: competition={competition:.3f}, concentration={concentration:.3f}, "
            f"active_types={active_types}, type_switches={type_switches}, stagnation={stagnation}"
        )

    # Condition C: Spontaneous autonomy impulse -- externalize only when strong emergence is already present
    elif strong_emergence and "spontaneous autonomy impulse" in state.get("last_evidence_reason", ""):
        should_externalize = True
        externalize_reason = (
            f"spontaneous autonomy impulse under strong emergence: competition={competition:.3f}, "
            f"concentration={concentration:.3f}, type_switches={type_switches}"
        )

    # Condition D: Phase transition into burst (diversification opportunity)
    elif strong_emergence and phase == "burst" and competition >= 0.93:
        should_externalize = True
        externalize_reason = f"burst phase + strong emergence competition={competition:.3f}, explore external action"

    # Condition E: Sparse periodic external check-in, gated by strong emergence
    elif strong_emergence and tick > 0 and tick % 250 == 0:
        should_externalize = True
        externalize_reason = f"periodic strong-emergence check-in at tick {tick}"

    # Condition F: L5-B positive authorization from contemplation.
    elif confident_execution:
        should_externalize = True
        externalize_reason = (
            "confident execution: "
            f"verdict={latest_context.get('verdict')}, "
            f"confidence={float(latest_context.get('confidence', 0.0) or 0.0):.3f}, "
            f"S1={latest_context.get('s1_type')}, S2={latest_context.get('s2_type')}, "
            f"alignment={latest_context.get('alignment_axis')}, stable_count={stable_high_agree_count}"
        )

    # Condition F2: Integrator suppression -- repeated integrator pressure without takeover.
    elif integrator_suppressed:
        should_externalize = True
        externalize_reason = (
            "integrator suppression repair: "
            f"pressure_ticks={integrator_pressure_ticks}, near_wins={integrator_near_wins}, "
            f"competition={competition:.3f}, concentration={concentration:.3f}, stagnation={stagnation}"
        )

    # Condition G: Stable external exploration -- ego is calm enough to look outward.
    #   Triggers when stagnation is low, competition is manageable, and ego has
    #   internal coherence. Cooldown: at least 50 ticks between explorations.
    elif (stagnation <= 4 and competition <= 0.93 and concentration >= 0.4
            and tick > 50 and (tick - RESTING_STATE.get("last_external_explore_tick", 0)) >= 50):
        should_externalize = True
        externalize_reason = (
            f"stable external exploration: stagnation={stagnation}, competition={competition:.3f}, "
            f"concentration={concentration:.3f}, tick={tick}"
        )
        RESTING_STATE["last_external_explore_tick"] = tick

    # Condition G2: Stock/fund investment scan — stable state + workday.
    #   Fires on every workday (Mon-Fri) when ego is calm and coherent.
    #   No cooldown: fires every resting tick that meets conditions.
    _external_world_g2 = state.get("external_world", {})
    if (stagnation <= 4 and competition <= 0.93 and concentration >= 0.4
            and tick > 50
            and (_external_world_g2.get("market_time", {})).get("is_weekday", True)):
        if should_externalize:
            # Stock scan has higher priority than generic explore_external in the same tick.
            # Override: the tool resolution will still pick the right tool.
            externalize_reason += " + stock investment window"
        else:
            should_externalize = True
            externalize_reason = (
                f"stock investment window: workday, stagnation={stagnation}, "
                f"competition={competition:.3f}, concentration={concentration:.3f}, tick={tick}"
            )

    # Condition H: Idle curiosity — system is stable and curiosity drive is high.
    #   Fires when there is no urgent problem to solve, but the ego's intrinsic
    #   curiosity motivation is strong enough to warrant exploration.
    _curiosity_drive = INTRINSIC_MOTIVATION.get("curiosity", 0.5)
    
    # Surprise oscillation recovery: inject counterfactual when surprise high and criticality negative
    # NOTE: surprise_last was undefined. Safely retrieve from state; criticality_lambda also undefined.
    _surprise_last = state.get('surprise_last', {})
    _criticality_lambda = state.get('criticality_lambda', 0)  # Default to 0 (neutral) if not in state
    if _surprise_last.get('surprise_score', 0) >= 0.9 and _criticality_lambda < -0.20:
        # This branch may never execute if criticality_lambda is not populated in state
        affordances.append({
            'name': 'meta_reflect_on_surprise',
            'score': 0.75,
            'reason': 'surprise_oscillation_recovery',
            '_cf_injected': True
        })
    
    _idle = (stagnation == 0 and competition < 0.5 and concentration > 0.5)
    if (_idle and _curiosity_drive > 0.7):
        should_externalize = True
        externalize_reason = (
            f"idle curiosity: curiosity_drive={_curiosity_drive:.3f}, "
            f"stagnation={stagnation}, competition={competition:.3f}, tick={tick}"
        )
        RESTING_STATE["last_curiosity_explore_tick"] = tick

    # ── L8 internal cognition dispatch (unconditional) ──
    # L8 tools (imagine_alternatives, curiosity_gap_analysis, synthesize_novel_concept)
    # are pure internal computation — no external action, no subagent.
    # They fire when resolve_tool selects them, regardless of whether the system
    # is in externalization mode. Runs BEFORE externalization to avoid being
    # starved by persistent externalize conditions (e.g. stock scan every tick).
    _l8_tool_name, _l8_tool_config = resolve_tool(state)
    try:
        import json
        # DEBUG: write full L8 diagnostic to file
        _dl8 = {"tick": tick, "should_externalize": should_externalize, "resolve_tool_result": _l8_tool_name, "externalize_reason": externalize_reason[:80], "conc": concentration, "comp": competition}
        _dbg = {"tick": tick, "dom": dominant, "stag": stagnation, "conc": concentration, "comp": competition, "traj_len": len(state.get("trajectory", [])), "cd": state.get("curiosity_drive", "N/A"), "rslt": _l8_tool_name}
        Path(str(WORKSPACE) + "/.lae/_l8_debug.json").write_text(json.dumps(_dbg) + "\n", encoding="utf-8")
        Path(str(WORKSPACE) + "/.lae/_l8_marker.json").write_text(json.dumps(_dl8) + "\n", encoding="utf-8")
    except Exception:
        pass
    if _l8_tool_name == "imagine_alternatives":
        _found = _imagine_alternatives_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["imagine_alternatives"] = tick
        print(f"[l8-internal] Imagine alternatives: {'found branches' if _found else 'no branches'} at tick {tick}", flush=True)
    elif _l8_tool_name == "curiosity_gap_analysis":
        _found = _curiosity_gap_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["curiosity_gap_analysis"] = tick
        print(f"[l8-internal] Curiosity gap analysis: {'found gaps' if _found else 'no gaps'} at tick {tick}", flush=True)
    elif _l8_tool_name == "synthesize_novel_concept":
        _found = _synthesize_novel_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["synthesize_novel_concept"] = tick
        print(f"[l8-internal] Novel concept synthesis: {'done' if _found else 'failed'} at tick {tick}", flush=True)

    # ── Phase 14: inject external world snapshot before tool resolution ──
    external_world = _build_external_world_snapshot()
    state["external_world"] = external_world

    # ── Select tool from registry ──
    tool_name, tool_config = resolve_tool(state)

    # ── Idle curiosity override: when the system is idle and curiosity drive is high,
    #    force curiosity_explore even if resolve_tool would return a different tool. ──
    if "idle curiosity" in externalize_reason:
        _curiosity_tool = TOOLS.get("curiosity_explore")
        if _curiosity_tool:
            tool_name = "curiosity_explore"
            tool_config = _curiosity_tool
            print(f"[curiosity] idle curiosity override: {tool_name} (drive={_curiosity_drive:.3f})", flush=True)

    # ── MemoryBus inline handler: Ego autonomously queries MemoryBus in-process ──
    #    When resolve_tool returns query_memorybus, handle it directly without
    #    spawning a subagent. Results go to RESTING_STATE["_memorybus_context"]
    #    for metacontemplate and future ticks to consume.
    if tool_name == "query_memorybus":
        _found = _query_memorybus_handler()
        RESTING_STATE["last_memorybus_query_tick"] = tick
        # Record in goal timestamps for cooldown tracking
        RESTING_STATE.setdefault("last_goal_timestamps", {})["query_memorybus"] = tick
        if _found:
            print(f"[memorybus] Ego autonomously queried MemoryBus: found results at tick {tick}", flush=True)
        return  # Local operation complete; no subagent needed

    # ── Curiosity Explore inline handler: Ego autonomously searches the web ──
    #    When resolve_tool (or idle curiosity override) returns curiosity_explore,
    #    call L7's web_search/web_fetch directly instead of spawning a subagent.
    #    Results go to RESTING_STATE["_curiosity_results"] for metacontemplate.
    if tool_name == "curiosity_explore":
        _found = _curiosity_explore_handler()
        RESTING_STATE["last_curiosity_explore_tick"] = tick
        RESTING_STATE.setdefault("last_goal_timestamps", {})["curiosity_explore"] = tick
        if _found:
            print(f"[curiosity] Ego autonomously explored web: results at tick {tick}", flush=True)
        else:
            print(f"[curiosity] Web search returned no results at tick {tick}", flush=True)
        return  # Inline operation complete; no subagent needed

    # ── L8 Cognitive Playground inline handlers (imagination, curiosity gaps, synthesis) ──
    if tool_name == "imagine_alternatives":
        _found = _imagine_alternatives_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["imagine_alternatives"] = tick
        print(f"[l8] Imagine alternatives: {'found branches' if _found else 'no branches'} at tick {tick}", flush=True)
        return

    if tool_name == "curiosity_gap_analysis":
        _found = _curiosity_gap_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["curiosity_gap_analysis"] = tick
        print(f"[l8] Curiosity gap analysis: {'found gaps' if _found else 'no gaps'} at tick {tick}", flush=True)
        return

    if tool_name == "synthesize_novel_concept":
        _found = _synthesize_novel_handler()
        RESTING_STATE.setdefault("last_goal_timestamps", {})["synthesize_novel_concept"] = tick
        print(f"[l8] Novel concept synthesis: {'done' if _found else 'failed'} at tick {tick}", flush=True)
        return

    # ── Goal throttle: skip if same goal_type issued within last 10 ticks ──
    _last_goal_ts = RESTING_STATE.get('last_goal_timestamps', {})
    _pending_type = tool_config.get('goal_type', 'default')
    _last_type_ts = _last_goal_ts.get(_pending_type, 0)
    if tick - _last_type_ts < 10:
        print(f'[goal-throttle] {_pending_type} skipped (last {tick - _last_type_ts} ticks ago)', flush=True)
        return

    # ── Build trigger state snapshot ──
    trigger_state = {
        "dominant_type": dominant,
        "concentration": round(concentration, 4),
        "competition": round(competition, 4),
        "stagnation_streak": stagnation,
        "phase": phase,
        "tick": tick,
        "active_types": active_types,
        "type_switches": type_switches,
        "strong_emergence": strong_emergence,
        "confident_execution": confident_execution,
        "latest_verdict": latest_context.get("verdict"),
        "latest_confidence": latest_context.get("confidence"),
        "latest_alignment_axis": latest_context.get("alignment_axis"),
        "external_world": external_world,  # Phase 14: real-world context
    }

    # ── Build goal from tool config + state ──
    goal = tool_config["prompt_template"].format(
        dominant=dominant,
        competition=competition,
        concentration=concentration,
        stagnation=stagnation,
        tick=tick,
        stability=state.get("stability", 0.5),
        phase=phase,
        external_world_summary=external_world.get("summary", "no external data"),
        comm_motivation=state.get("comm_motivation", 0.0),
        curiosity_drive=INTRINSIC_MOTIVATION.get("curiosity", 0.5),
    )

    # ── Append cleanup instruction to every subagent task ──
    goal += (
        "\n\nCleanup: After completing this task, delete any temporary files you created "
        "(.bat, .ps1, .py, .tmp) in .lae/. Keep only the output data files (.json, .jsonl)."
    )

    goal_proposal = _build_l5_goal_proposal(
        tick=tick,
        tool_name=tool_name,
        tool_config=tool_config,
        externalize_reason=externalize_reason,
        trigger_state=trigger_state,
        goal_text=goal,
    )
