            print(f"[S51e-integ-arm] counter=0+dom=integrator+int_press -> armed to 100", flush=True)
        _mid_range_reset = (
            20 <= _int_press_ctr <= 35
            and result.get("dominant") == "integrator"
            and _bistable_off_streak >= 8
            # S51-mid_range-bistable-guard: only fire on genuine bistable exit (8 consecutive
            # non-bistable windows = same criterion used to clear _bistable_persistent_s51).
            # During active bistable oscillation, counter drains naturally to 0, allowing §49b
            # to grant 160-tick grace. Without this guard, mid_range_reset fires on integrator
            # ticks during active oscillation (counter 20-35) → counter=160, never reaches 0,
            # §49b zero-crossing guard never fires, resting_concentration stays 0.25-0.35.
        )
        if (not _bistable_persistent_s51 and _int_press_ctr <= 5 and _integration_pressure and result.get("dominant") != "rule_modification") or _mid_range_reset:
            _int_press_ctr = 160  # l5g-20260712-000051: counter-arm at low-counter boundary. Old guard required dominant==integrator (circular: needs integrator to win to arm grace, but grace too short for integrator to win). New: arm when counter<=10 and integration_pressure still True, giving integrator 160-tick runway before heater re-engages. rule_mod excluded (independent drain path).
            _int_press_ctr_was_positive_before = True  # §53-fix-bis (2026-06-27): re-arm §49b zero-crossing detection; True allows §49b to fire on genuine counter=0 drain event, granting 80-tick grace for integrator STDP consolidation
        RESTING_STATE["_int_press_counter"] = _int_press_ctr  # §S51-arm-save (2026-06-29): persist counter after all arm blocks; without this, S51c/S51d/mid_range arm values (30/160) are lost and next tick reads stale pre-arm value
        # §48 (2026-06-27): Grace counter guard.
        # Bug: grace ticks (counter > 0) also fired the action_heater, building action->action
        # STDP edges during the protected grace period, suppressing integrator consolidation.
        # Fix: counter-drain ticks skip the heater branch entirely; heater fires only when
        # counter has drained to 0 and integration_pressure is truly absent.
        if _int_press_ctr > 0:
            # §50 (2026-06-27): Grace-tick bistable oscillation guard removed.
            # Root cause: the §49-b guard (L6635-6644) reset counter to 40 whenever bistable
            # oscillation was detected in the last 8 ticks. Since bistable oscillation lasts 10+
            # consecutive ticks, this reset fired on EVERY grace tick, permanently locking the
            # counter at 40 and never letting it drain to 0. Result: action_heater ran 0/25 ticks
            # in recent window, structural STDP imbalance (NEWBORN: 2 action seeds/tick) never
            # corrected, integrator wins weakly (conc=0.25-0.36) but never decisively.
            # Fix: remove grace-tick bistable reset. The zero-crossing guard (L6609-6622) already
            # handles counter=0 oscillation detection. Letting counter drain naturally allows
            # action_heater to run periodically, restoring STDP balance.
            if _integration_pressure:
                _integrator_list_g = [nid for nid, nt in NEURON_TYPE.items() if nt == "integrator"]
                _replaced_int_g = 0
                _new_path_int_g = []
                _stag_g = RESTING_STATE.get("stagnation_streak", 0)
                _type_counts_g = {parse_type(s): 0 for s in seeds}
                for _s in seeds:
                    _type_counts_g[parse_type(_s)] += 1
                _int_in_pool_g = _type_counts_g.get('integrator', 0)
                _non_int_g = {t: c for t, c in _type_counts_g.items() if t != 'integrator'}
                _max_comp_g = max(_non_int_g.values()) if _non_int_g else 1
                _skew_g = max(0.0, _max_comp_g / max(1, _int_in_pool_g) - 1.0)
                _rate_g = min(0.70, (0.35 if _stag_g >= 3 else 0.30) + _skew_g * 0.30)
                for step_set_g in result.get("activation_path", []):
                    _ns_g = set()
                    for nid_g in step_set_g:
                        if (parse_type(nid_g) == "action"
                                and _integrator_list_g and random.random() < _rate_g):
                            _ns_g.add(random.choice(_integrator_list_g))
                            _replaced_int_g += 1
                        else:
                            _ns_g.add(nid_g)
                    _new_path_int_g.append(_ns_g)
                result["activation_path"] = _new_path_int_g
                if _replaced_int_g > 0:
                    print(f"[integrator_push][grace] replaced {_replaced_int_g} action->integrator ",
                          f"neurons (press={_integration_pressure}, ctr={_int_press_ctr})", flush=True)
            pass  # grace tick — skip heater branch below

        elif not _integration_pressure:
            # §32 (2026-06-24): Apply evolved_action_heater_ratio as per-neuron
            # replacement probability. Ratio=1.0 = legacy all-or-nothing.
            # Ratio<1.0 = graduated scaling, reducing heater pressure during
            # moderate integration windows where guard did NOT fire.
            _ahr = RESTING_STATE.get("evolved_action_heater_ratio", 1.0)
            for step_set in result["activation_path"]:
                _new_set = set()
                for nid in step_set:
                    if nid in _defense_set and random.random() < _ahr:
                        _new_set.add(random.choice(_action_list))
                        _replaced += 1
                    else:
                        _new_set.add(nid)
                _new_path.append(_new_set)
            result["activation_path"] = _new_path
            if _replaced > 0:
                print(f"[action_heater] STDP rebalance (ahr={_ahr:.2f}): replaced {_replaced} defense→action "
                      f"neurons in activation_path", flush=True)
        else:
            # section 45 (2026-06-26): Integrator push during high integration pressure.
            # Root cause: the guard correctly skips defense->action heater but does NOT
            # actively promote integrator. Action structural STDP self-reinforcement
            # means action still dominates even when the heater is off.
            # Fix: replace ~20% of action neurons in activation_path with integrator neurons.
            # §45-C (2026-06-26): Scaled rate — stag>=3 uses 0.35 (was fixed 0.20).
            # 10 grace ticks with 20% = ~8-16 swaps/tick; action 3x STDP keeps it dominant.
            # 35% gives ~14-28 swaps/tick, enough to shift type_activation ratio.
            _integrator_list = [nid for nid, nt in NEURON_TYPE.items() if nt == "integrator"]
            _replaced_int = 0
            _new_path_int = []
            _stag_for_push = RESTING_STATE.get("stagnation_streak", 0)
            # §45-D (2026-06-26): Pool-imbalance aware push rate.
            # When SEED pool has more action than integrator (skew>1), increase push rate
            # to overcome structural pool advantage from NEWBORN seeds + external evidence.
            # Pool skew = max(0, max_competitor_count / max(1, integrator_count) - 1.0)
            # push_rate = base + skew * 0.30, capped at 0.50
            # Fix: use strongest non-integrator competitor (not just action) so skew is
            # positive whenever any competing type outnumbers integrator in the pool.
            _type_counts_p = {parse_type(s): 0 for s in seeds}
            for _s in seeds:
                _type_counts_p[parse_type(_s)] += 1
            _int_in_pool = _type_counts_p.get('integrator', 0)
            _non_int_p = {t: c for t, c in _type_counts_p.items() if t != 'integrator'}
            _max_comp_p = max(_non_int_p.values()) if _non_int_p else 1
            _pool_skew = max(0.0, _max_comp_p / max(1, _int_in_pool) - 1.0)
            _push_rate = min(0.70, (0.35 if _stag_for_push >= 3 else 0.30) + _pool_skew * 0.30)
            for step_set in result["activation_path"]:
                _new_step = set()
                for nid in step_set:
                    if (parse_type(nid) == "action"
                            and _integrator_list and random.random() < _push_rate):
                        _new_step.add(random.choice(_integrator_list))
                        _replaced_int += 1
                    else:
                        _new_step.add(nid)
                _new_path_int.append(_new_step)
            result["activation_path"] = _new_path_int
            if _replaced_int > 0:
                print(f"[integrator_push] integration_pressure: replaced "
                      f"{_replaced_int} action->integrator neurons in activation_path", flush=True)

    # ── §12-C (2026-06-26): Integrator-priority anti-fixation ──
    # When stagnation is high, inject integrator as the FIX type, not random minority.
    # Previous: 2 random minority types from 5+ missing = ~40% chance integrator.
    # Fix: stag>=5 → inject integrator first (priority FIX), remaining budget = random fill.
    _stag = RESTING_STATE.get("stagnation_streak", 0)
    if _stag >= 3:
        _present_types = set(parse_type(nid) for nid in result.get("final_state_top10", []))
        _all_known = {'sensory', 'memory', 'integrator', 'decider', 'action',
                      'doubt', 'veto', 'rule_modification'}
        _missing = _all_known - _present_types - {"unknown"}
        if _missing:
            _injected = 0
            _new_path = []
            for step_set in result["activation_path"]:
                _new_set = set(step_set)
                if _stag >= 5 and "integrator" in _missing:
                    # High stagnation: inject integrator as priority FIX type.
                    _cand = [nid for nid, nt in NEURON_TYPE.items() if nt == "integrator"]
                    if _cand:
                        _new_set.add(random.choice(_cand))
                        _injected += 1
                # Fill remaining budget (up to 2 total) with random minority types.
                _fill = 2 - _injected
                if _fill > 0:
                    for _mtyp in list(_missing)[:_fill]:
                        _candidates = [nid for nid, nt in NEURON_TYPE.items() if nt == _mtyp]
                        if _candidates:
                            _new_set.add(random.choice(_candidates))
                            _injected += 1
                _new_path.append(_new_set)
            result["activation_path"] = _new_path
            _label = "integrator" if _stag >= 5 else "minority"
            print(f"[anti-fixation] {_label} push: injected {_injected} neurons "
                  f"(stag={_stag}, missing={_missing})", flush=True)

    # ── §16-B: Self-prediction surprise -- compare prediction to actual ──
    _actual_dominant = result["dominant"]
    _actual_concentration = result.get("concentration", 0.5)
    _predicted_dominant = _self_prediction["predicted_dominant"]
    _predicted_conc = _self_prediction["predicted_concentration"]

    # Dominant type surprise (binary: did I switch type?)
    _type_surprise = 1.0 if _actual_dominant != _predicted_dominant else 0.0
    # Concentration surprise (normalized distance)
    _conc_surprise = min(1.0, abs(_actual_concentration - _predicted_conc) / 0.5)
    # Combined surprise score
    _surprise = max(_type_surprise, _conc_surprise * 0.5)
    _surprise_threshold = 0.3

    if _surprise > _surprise_threshold:
        _surprise_msg = (
            f"I predicted {_predicted_dominant} (conc={_predicted_conc:.2f}) "
            f"but got {_actual_dominant} (conc={_actual_concentration:.2f})"
