        pool = load_neurons(WORKSPACE)
        _creative_path = WORKSPACE / ".lae" / "stage4_creative_candidates.jsonl"
        _candidate_count = 0
        if _creative_path.exists():
            try:
                # Status must stay cheap: this file can grow large enough that
                # full-line counting piles up HTTP worker threads.
                with _creative_path.open("r", encoding="utf-8") as _cf:
                    for _candidate_count, _line in enumerate(_cf, start=1):
                        if _candidate_count >= 10000:
                            break
            except Exception:
                pass
        status["stage4"] = {
            "reasoning_neurons": len(pool.get("neurons", {})),
            "creative_candidates": _candidate_count,
            "last_updated": pool.get("last_updated"),
        }
    except Exception as e:
        status["stage4"] = {"error": str(e), "creative_candidates": 0}
    return status


def _consume_external_evidence():
    """Read and consume external evidence files, inject into RESTING_STATE.
    Called from _resting_tick_impl() with RESTING_LOCK already held.
    
    For each evidence file:
      1. Written by an external agent (e.g. autonomy evidence, L5 bridge intent)
      2. resting_tick reads, validates JSON, extracts key metadata
      3. Injects into RESTING_STATE["external_evidence"] for next tick's seed biasing
      4. Writes .consumed marker, deletes original to prevent re-processing
    """
    injected = {}

    for key, path in EVIDENCE_PATHS.items():
        if not path.exists():
            continue
        consumed_path = path.with_name(path.name + ".consumed")
        # If both orig + consumed exist, this is a NEW file -- clear old marker and re-consume
        if consumed_path.exists():
            try:
                consumed_path.unlink(missing_ok=True)
            except Exception:
                pass
        try:
            content = json.loads(path.read_text(encoding="utf-8"))
            # Support both standard format (triggered_at/state_snapshot/intent_type)
            # and custom format (action/title/reason/request/expected_result)
            ts = content.get("triggered_at") or content.get("ts", content.get("timestamp", "?"))
            tick = content.get("state_snapshot", {}).get("tick", "?")
            intent_type = content.get("intent_type", content.get("action", "?"))
            _clog = WORKSPACE / "_evidence_log.txt"
            try:
                with open(_clog, "a", encoding="utf-8") as _cf:
                    _cf.write(f"[consume] {key}: tick={tick} ts={ts} intent={intent_type}\n")
            except Exception:
                pass
            print(f"[consume] {key}: tick={tick} ts={ts} intent={intent_type}", flush=True)
            # ── Log structured consumption event ──
            _domain = content.get("domain", content.get("state_snapshot",{}).get("dominant","?"))
            _write_consumption_log({
                "event": "consumed",
                "tick": RESTING_STATE.get("tick", 0),
                "source": key,
                "file_key": key,
                "intent": intent_type,
                "target_type": _domain,
                "reason": content.get("reason", ""),
            })
            injected[key] = content
            # Write consumed marker atomically
            marker = {
                "consumed_key": key,
                "consumed_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                "summary": f"{key}: tick={tick} intent={intent_type}",
            }
            consumed_path.write_text(json.dumps(marker, indent=2) + "\n", encoding="utf-8")
            # Delete original to prevent re-processing
            path.unlink(missing_ok=True)
        except Exception as e:
            print(f"[consume] {key} error: {e}", flush=True)
            # On parse error, rename to .consumed to avoid re-processing
            try:
                path.rename(consumed_path)
            except Exception:
                pass

    if injected:
        # Merge with existing -- evidence persists across ticks
        existing = RESTING_STATE.get("external_evidence", {})
        existing.update(injected)
        RESTING_STATE["external_evidence"] = existing
        # Set TTL for each new entry
        ttl = RESTING_STATE.get("evidence_persist_ticks", 5)
        ttl_dict = RESTING_STATE.get("evidence_ttl", {})
        for k in injected:
            ttl_dict[k] = ttl
        RESTING_STATE["evidence_ttl"] = ttl_dict
        print(f"[consume] injected {len(injected)} evidence entries (ttl={ttl})", flush=True)
    _promote_l7_observations_to_evidence()
    return injected


def _promote_l7_observations_to_evidence():
    """Expose queued L7 observations to the normal external-evidence seed bias."""
    evidence = RESTING_STATE.get("external_evidence", {})
    l7_obs = evidence.get("l7_observations", [])
    if not isinstance(l7_obs, list):
        return {}

    tick = RESTING_STATE.get("tick", 0)
    now = time.time()
    promoted = {}
    ttl_dict = RESTING_STATE.get("evidence_ttl", {})

    for obs in l7_obs:
        if not isinstance(obs, dict):
            continue
        obs_id = obs.get("l7_observation_id") or hashlib.md5(
            json.dumps(obs, sort_keys=True, default=str).encode("utf-8")
        ).hexdigest()[:12]
        key = f"l7_evidence_{obs_id}"
        if key in evidence:
            continue

        ttl_key = f"l7_obs_{obs_id}"
        obs_ttl = ttl_dict.get(ttl_key, obs.get("l7_ttl", 10))
        age_ticks = tick - obs.get("injected_tick", tick)
        age_time = now - obs.get("injected_at", now)
        if age_ticks >= obs_ttl or age_time >= 300:
            continue

        target_types = []
        for candidate in [obs.get("domain"), obs.get("l7_mission_target"), *obs.get("trigger_types", [])]:
            if candidate in TYPE_NAMES and candidate not in target_types:
                target_types.append(candidate)
        if not target_types:
            target_types = ["sensory"]

        primary = target_types[0]
        promoted[key] = {
            "source": obs.get("source", "l7_external"),
            "intent_type": obs.get("intent_type", "external_exploration"),
            "domain": primary,
            "trigger_types": target_types,
            "action": obs.get("tool", "l7_observation"),
            "title": obs.get("summary", "L7 observation"),
            "request": obs.get("content_preview", obs.get("summary", "")),
            "reason": "promoted from L7 observation queue",
            "n_replace": 2,
            "l7_observation_id": obs_id,
        }

    if promoted:
        evidence.update(promoted)
        RESTING_STATE["external_evidence"] = evidence
        ttl = RESTING_STATE.get("evidence_persist_ticks", 5)
        for key in promoted:
            ttl_dict[key] = ttl
        RESTING_STATE["evidence_ttl"] = ttl_dict
        print(f"[consume] promoted {len(promoted)} L7 observations into evidence (ttl={ttl})", flush=True)
    return promoted


def _generate_ego_evidence():
    """Ego self-generates external evidence from internal resting state.

    Phase 11: Self-directed evidence for autonomous type shifting.
    Called from _resting_tick_impl() AFTER _consume_external_evidence().

    Flow:
      1. Read current RESTING_STATE (dominant, stagnation, phase, tick, trajectory)
      2. Apply rules to decide a target type shift
      3. Write ego_autonomy_evidence.json with TTL
      4. Next tick's _consume_external_evidence injects it
      5. Seed bias nudges KWTA attractor toward target type

    This is the core autonomy mechanism: pure Python logic that completely
    bypasses the LLM safety alignment layer which blocked self-referential
    evidence generation via contemplate().
    """
    state = RESTING_STATE
    dominant = state.get("last_dominant", "unknown")
    stagnation = state.get("stagnation_streak", 0)
    tick = state.get("tick", 0)
    phase = state.get("noise_schedule", "explore")
    traj = state.get("trajectory", [])

    # ── Decide target type ──
    target = None
    reason = ""

    # Rule 0: Integrator heater -- high competition + stuck dominant -> need synthesis
    competition = state.get("competition", 0)
    # §S57: Oscillation-aware integrator trigger.
    # When bistable oscillation is active (_bistable_persistent_s51), treat
    # stagnation>=1 as sufficient — persistent oscillation IS stagnation.
    # Without this, a 2-tick blind spot lets action_heater rebuild STDP.
    _osc_persist = RESTING_STATE.get("_bistable_persistent_s51", False)
    if competition > 0.75 and (stagnation >= 3 or (stagnation >= 1 and _osc_persist)):
        target = "integrator"
        reason = f"high competition ({competition:.2f}) + {dominant} stuck (stag={stagnation}) -> activate integrator to resolve attractor fragmentation"

    # Rule 0.5: Integration drive -- high synthesis pressure -> integrator even without stagnation
    # Prevents the tick=372/378 stalemate where integration_drive=0.28+ but stag=0 blocks Rule 0.
    # Fire whenever drive > 0.2; n_replace=8 (moderate, between base=2 and heater=12).
    # §19: Respect commander_override -- skip integrator when action anchor is active.
    integration_drive = state.get("integration_drive", 0)
    _has_co = RESTING_STATE.get("external_evidence", {})
    _has_co = any(isinstance(_d, dict) and _d.get("priority") == "commander_override" for _d in _has_co.values())
    if integration_drive > 0.2 and target is None and not _has_co:
        target = "integrator"
        reason = f"integration_drive ({integration_drive:.3f}) > 0.2 -> synthesis pressure requires integrator"

    # Rule 1: Stagnation escape -- dominant stuck for >= 5 ticks
    elif stagnation >= 5:
        # Avoid the current dominant; avoid memory unless it's the only option
        types = [t for t in TYPE_NAMES if t != dominant]
        if len(types) > 1 and "memory" in types:
            # Prefer shifting to sensory or decider during stagnation
            preferred = [t for t in types if t in ("sensory", "decider")]
            if preferred:
                types = preferred
        target = random.choice(types)
        reason = f"stagnation={stagnation} on {dominant}, escape"

    # Rule 2: Burst phase -- diversify to a type far from current
    elif phase == "burst" and dominant != "unknown":
        # Map types to indices for distance computation
        type_order = ["sensory", "integrator", "decider", "action", "memory", "rule_modification"]
        if dominant in type_order:
            idx = type_order.index(dominant)
            # Pick a type at opposite end
            far = type_order[-(idx + 1)] if idx < len(type_order) // 2 else type_order[0]
            target = far
            reason = f"burst phase, diversify from {dominant}"
        else:
            target = random.choice(TYPE_NAMES)
            reason = "burst phase, random diversification"

    # Rule 3: Periodic self-check every 20 ticks
    elif tick > 0 and tick % 20 == 0:
        # Look at trajectory to find least activated type
        if len(traj) >= 10:
            recent = traj[-10:]
            type_counts = Counter()
            for e in recent:
                tc = e.get("type_counts", {})
                for t, c in tc.items():
                    type_counts[t] += c
            if type_counts:
                # Find type with lowest recent activation
                sorted_types = sorted(type_counts.items(), key=lambda x: x[1])
                target = sorted_types[0][0]
                reason = f"periodic self-check at tick {tick}, boost least active:"
        if target is None:
            target = "integrator" if random.random() < 0.6 else "decider"
            reason = f"periodic self-check at tick {tick}"

    # Rule 4: Random spontaneous impulse (~2.5% per tick)
    elif random.random() < 0.025:
        target = random.choice(TYPE_NAMES)
        reason = "spontaneous autonomy impulse"

    if target is None:
        return  # no evidence to write this tick

    # ── Compute n_replace: integrator heater -> aggressive (12), stagnation>=6 -> 5, base=2 ──
    if target == "integrator" and ("activate integrator" in reason or "integration_drive" in reason):
        n_replace = 12  # P6: aggressive seed replacement for integrator activation
    elif stagnation >= 6:
        n_replace = 5
    else:
        n_replace = 2

    evidence = {
        "action": "shift_dominant",
        "title": f"self-directed shift to {target}",
        "domain": target,
        "reason": reason,
        "request": f"Shift cognitive dominant type toward {target}",
        "expected_result": f"Dominant type moves toward {target}",
        "intent_type": "self_directed_shift",
        "triggered_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "tick": tick,
        "source": "ego_self_generated",
        "n_replace": n_replace,  # Phase 11-B: self-determined bias strength
    }

    # ── Store reason so _externalize_autonomy_impulse can detect Rule 4 ──
    RESTING_STATE["last_evidence_reason"] = reason

    path = EVIDENCE_PATHS.get("self_evidence")
    if path:
        try:
            path.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
            print(f"[self-evidence] WROTE: {target} -- {reason}", flush=True)
        except Exception as e:
            print(f"[self-evidence] write error: {e}", flush=True)


# ─── Communication Motivation -- Ego decides when to speak ───

def _calculate_comm_motivation():
    """Calculate intrinsic communication motivation.

    This is NOT threshold-based. It's a drive that builds up over time
    based on how much the ego has changed since last message. Ego can
    choose to speak or stay quiet based on this internal drive.

    Components:
    - novelty_surprise: stagnation delta, dominant type change, phase change
    - elapsed_time: ticks since last message (normalized, saturates at 50)
    - insight_confidence: from recent context memory
    - spontaneous_drive: small random component for "I want to say something"
    - decay: natural decay of motivation over time (prevents saturation)
    """
    state = RESTING_STATE
    last_tick = state.get("last_comm_tick", 0)
    current_tick = state.get("tick", 0)

    elapsed = current_tick - last_tick
    suppress_at = state.get("comm_suppress_until", 0)

    # ── L5g-20260709-000071: comm_motivation seed for integration-pressure post-suppression ──
    # Root cause: after restart, suppress_until=0 and the integration escape (line 9865)
    # never fires until suppress_until>0, but _try_message_commander creates suppress_until
    # only when motivation>=0.4. The stale-suppress guard (line 9924) then sets
    # _comm_supp_just_escaped=True even when the integration escape didn't fire, causing
    # the elapsed<5 guard (line 9943) to return 0.0 every tick. comm_motivation stays at 0.01,
    # never reaches 0.4, and the 60-120t suppression cycle re-arms indefinitely.
    # Fix: seed comm_motivation at function entry when integration_drive is high and
    # suppress_until is not currently suppressing. This works even in the cold-start case
    # (suppress_until=0) and the seed is idempotent (only fires when mot<=0.01).
    # The seed uses integration_drive from load_drives (preferred) or RESTING_STATE fallback.
    if not RESTING_STATE.get("_comm_motivation_seeded_this_tick", False):
        try:
            from stage2_homeostatic_drives import load_drives
            _int_drive = load_drives(WORKSPACE).get('drives', {}).get('integration', 0.0)
        except Exception:
            _int_drive = state.get("integration_drive", 0.0)
        if _int_drive >= 0.45 and RESTING_STATE.get("comm_motivation", 0.0) <= 0.01:
            RESTING_STATE["comm_motivation"] = 0.55
            print(f"[comm_motivation_seed] seeded 0.01->0.55 (int_drive={_int_drive:.3f} tick={current_tick})", flush=True)
        RESTING_STATE["_comm_motivation_seeded_this_tick"] = True
    # ── Pre-fetch state variables used in suppression escape below ──
    stagnation = state.get("stagnation_streak", 0)
    dominant = state.get("last_dominant", "unknown")

    # ── State-aware suppression escape (L5 rule_modification_repair v2) ──
    # Snapshot the dominant AT SUPPRESSION CREATION TIME so we can detect
    # a real change, not a tautology. _comm_supp_start_dom defaults to "unknown"
    # but last_dominant is always a concrete type — comparing against "unknown"
    # always yields True, perpetually resetting suppress_until=current_tick.
    _start_tick = state.get("_comm_supp_start_tick", current_tick)
    if current_tick <= suppress_at:
        # Absolute timeout: suppression cannot exceed MAX_SUPPRESS_TICKS beyond start tick.
        # Without this, 0-tick escape creates self-reinforcing deadlock: suppress_until=current_tick
        # expires immediately, stacking guard re-creates a new 60-120 window next tick.
        if current_tick - _start_tick >= 20:
            RESTING_STATE["comm_suppress_until"] = current_tick
            RESTING_STATE["_comm_supp_just_escaped"] = True
            suppress_at = current_tick
        else:
            # Only extend if stagnation INCREASED from ORIGINAL snapshot.
            # Drop type-change reset (causes perpetual loop: dominant flips each tick).
            _start_stag = state.get("_comm_supp_start_stag", stagnation)
            # Integrator-dominant escape: when stagnation is flat but dominant shifted
            # to integrator (and was not integrator at suppression start), release early.
            # _comm_supp_start_dom is a one-shot snapshot — no perpetual-loop risk.
            _start_dom = state.get("_comm_supp_start_dom", "unknown")
            # L5g-20260709-000041: adaptive release driven by integration drive pressure.
            # When drives.integration >= 0.50, the internal pressure to integrate/synthesize
            # is high enough that long comm suppression becomes a deadlock: comm stays
            # silent (motivation=0) while integration_drive stays high, and neither
            # stagnation nor dominant shift to trigger the existing escape conditions.
            # Threshold lowered from 0.55 to 0.50 (was 0.0145 too high for drive=0.5355)
            # and now matches the S51e arm threshold (0.50), closing the suppression gap.
            # Adaptive release: shorten suppress window to current_tick+10, giving the
            # system a fast-release path without removing the original escape conditions.
            try:
                from stage2_homeostatic_drives import load_drives
                _int_drive = load_drives(WORKSPACE).get('drives', {}).get('integration', 0.0)
            except Exception:
                _int_drive = state.get("integration_drive", 0.0)
            remaining = suppress_at - current_tick
            if (_int_drive >= 0.45 and remaining > 10) or stagnation > _start_stag or _start_dom != dominant:
                RESTING_STATE["comm_suppress_until"] = current_tick
                RESTING_STATE["_comm_supp_just_escaped"] = True
                suppress_at = current_tick
                # Preserve original dominant to prevent tautology on next call.
                # Without this, _comm_supp_start_dom stays 'unknown' (set only by
                # _try_message_commander during new-suppression creation), so
                # _start_dom != dominant is always True and suppress_until resets to
                # current_tick every call, permanently blocking the age guard.
                RESTING_STATE["_comm_supp_start_dom"] = dominant
                # L5g-20260709-000041-fix2: also update _comm_supp_start_tick so the age
                # guard and integration escape both use the ESCAPE tick as their baseline.
                # Without this, _comm_supp_start_tick stays at the ORIGINAL creation tick,
                # so current_tick - _start_tick >= 20 fires on every subsequent tick,
                # causing suppress_until to reset to current_tick each call and the
                # suppression window never actually expires.
                # L5g-20260712-000041-fix: DO NOT reset _comm_supp_start_tick here.
                # Resetting it each escape cycle makes the age-guard (current_tick -
                # _start_tick >= 50) permanently unreachable, turning the 50-tick
                # hard timeout into an effectively-permanent suppression window.
                # _comm_supp_start_tick was already set at suppression creation time
                # in _try_message_commander and must not be overwritten by escape.
                # L5g-20260709-000031-motivation-seed: when integration_drive >= 0.45 triggered this escape
                # and comm_motivation is still zero, seed it at 0.45 so motivation can accumulate over
                # subsequent ticks instead of being reset to 0.0 by the elapsed<5 / no-novelty path.
                # Without this, R1 fires every tick but motivation never climbs above 0.4,
                # and the suppress-until cycle (60-120t) re-arms before comm can speak.
                if _int_drive >= 0.45 and RESTING_STATE.get("comm_motivation", 0.0) <= 0.01:
                    RESTING_STATE["comm_motivation"] = 0.55
                    print(f"[suppression_escape] comm_motivation seeded 0.0->0.55 (drive={_int_drive:.3f})", flush=True)


    # Age guard (l5g-20260706-000071): measure ELAPSED suppression duration from
    # _start_tick, not remaining window. Old guard used suppress_at - current_tick
    # (forward-looking) which is only >_MAX_SUPPRESS_AGE when remaining window is large;
    # it goes silent as soon as suppress_until shrinks to <=current_tick+50 even if
    # suppression is still active. This causes deadlock when hard timeout is unreachable
    # (_start_tick defaulted to current_tick => elapsed=0) and dominant/stagnation escape
    # both fail simultaneously. Fix: use current_tick - _start_tick >= _MAX_SUPPRESS_AGE
    # to guarantee release after _MAX_SUPPRESS_AGE ticks regardless of suppress_until.
    _MAX_SUPPRESS_AGE = 50
    if current_tick - _start_tick >= _MAX_SUPPRESS_AGE:
        RESTING_STATE["comm_suppress_until"] = current_tick
        RESTING_STATE["_comm_supp_just_escaped"] = True
        suppress_at = current_tick
        # L5g-20260708-000051: drain counter during suppression escape so grace mechanism can activate
        _ctr = int(RESTING_STATE.get("_int_press_counter", 0) or 0)
        if _ctr > 0:
            RESTING_STATE["_int_press_counter"] = _ctr - 1
            print(f"[suppression_escape] _int_press_ctr drained {_ctr}->{_ctr-1}", flush=True)

    # If suppressed, return 0
    if current_tick < suppress_at:
        return 0.0

    # L5g-20260710-000171: stale-suppress guard removed.
    # Root cause: guard fired 2 ticks after every intentional escape (suppress_until=current_tick),
    # re-arming suppress_until before comm_motivation could climb from the 0.55 seed value.
    # The cooldown check (elapsed<5 + _comm_supp_just_escaped pop) already handles the
    # 3-tick post-escape quiet period. The age guard (MAX_SUPPRESS_AGE=50) provides the
    # hard timeout for cases where escape conditions never fire. Removing this guard lets
    # the normal post-escape motivation build path run without premature re-arming.

    # L7 successful external engagement can create a small motivation bump even
    # during quiet periods. Do not hard-suppress when L7 just injected fresh
    # external observations.
    _recent_l7 = False
    try:
        _l7_obs = RESTING_STATE.get("external_evidence", {}).get("l7_observations", [])
        if _l7_obs:
            _recent_l7 = any((time.time() - float(o.get("injected_at", 0))) < 60 for o in _l7_obs)
    except Exception:
        pass

    # Too soon after last message (skip if never messaged: last_comm_tick=0)
    # Bypass elapsed cooldown when we just escaped suppression: the stale-suppress
    # guard above set _comm_supp_just_escaped=True, so pop it and skip this block.
    if last_tick > 0 and elapsed < 5 and not RESTING_STATE.pop("_comm_supp_just_escaped", False):
        return RESTING_STATE.get("comm_motivation", 0.0)  # preserve seed from integration escape

    # If L7 is actively injecting external observations, reduce cooldown so comm_motivation
    # can rebuild instead of staying at 0. This avoids the L7->comm_motivation deadlock.
    if _recent_l7 and elapsed >= 5:
        return max(0.0, min(0.35, elapsed / 100.0))

    # Not enough ticks elapsed for meaningful state (need at least 3 ticks)
    if current_tick < 3:
        return 0.0

    # ── Novelty: how much has changed since last message ──
    stagnation = state.get("stagnation_streak", 0)
    prev_stagnation = state.get("prev_comm_stagnation", 0)
    stagnation_delta = abs(stagnation - prev_stagnation)

    dominant = state.get("last_dominant", "unknown")
    prev_dominant = state.get("prev_comm_dominant", "unknown")
    type_changed = 1.0 if dominant != prev_dominant else 0.0

    phase = state.get("noise_schedule", "explore")
    prev_phase = state.get("prev_comm_phase", "explore")
    phase_changed = 1.0 if phase != prev_phase else 0.0

    novelty = (stagnation_delta / 10.0) * 0.25 + type_changed * 0.30 + phase_changed * 0.20

    # ── Time drive: builds up over time, saturates at 100 ticks (~50 min) ──
    time_drive = min(elapsed / 100.0, 1.0) * 0.25

    # ── Insight confidence: from recent context ──
    recent_context = CONTEXT_MEMORY[-1] if CONTEXT_MEMORY else {}
    confidence = float(recent_context.get("confidence", 0.0) or 0.0)
    insight = confidence * 0.15

    # ── Spontaneous drive: small random for "I just want to say something" ──
    spontaneous = random.uniform(0.0, 0.03)  # Reduced from 0.10 to 0.03

    # ── Decay: natural motivation decay (20% per tick, increased from 8%) ──
    prev_motivation = state.get("comm_motivation", 0.0)
    decay = prev_motivation * 0.20

    motivation = max(0.0, min(1.0,
        prev_motivation - decay + novelty + time_drive + insight + spontaneous
    ))

    return motivation


def _try_message_commander():
    """Ego decides whether to speak based on intrinsic motivation.

    Decision logic:
    - motivation < 0.4: doesn't feel like talking, stays quiet
    - motivation 0.4-0.7: might speak, but can also choose to stay quiet
      (higher motivation = higher probability of speaking)
    - motivation >= 0.7: strong urge to communicate, almost always speaks

    When ego chooses to stay quiet, it sets a suppression window
    so it doesn't keep reconsidering every tick.
    """
    motivation = _calculate_comm_motivation()
    RESTING_STATE["comm_motivation"] = motivation

    if motivation < 0.4:
        return  # Doesn't feel like talking

    # At moderate motivation, ego might choose to stay quiet
    if motivation < 0.7:
        if random.random() > motivation:
            # Suppression stacking guard: if window already active, don't extend it.
            # Bug 2 fix (l5g-20260624-000291): prevents 60-120t compounding into 300+t deadlocks.
            current_suppress = RESTING_STATE.get("comm_suppress_until", 0)
            # If escape just fired, suppress_until=current_tick means suppression was released.
            # Guard reads suppress_uintil AFTER escape and sees tick==suppress_until (not <),
            # so it would bypass and immediately create a new 60-120t window.
            # Check the flag first to break the compounding loop.
            if RESTING_STATE.pop("_comm_supp_just_escaped", False):
                return
            if RESTING_STATE["tick"] < current_suppress:
                print(f"[comm] skip re-suppression: window active until {current_suppress}", flush=True)
                return
            # Chose silence -- suppress for a meaningful cooldown window.
            # Keep this aligned with post-message cooldown to avoid reconsidering every tick.
            quiet_ticks = random.randint(60, 120)
            RESTING_STATE["_comm_supp_start_stag"] = RESTING_STATE.get("stagnation_streak", 0)
            RESTING_STATE["_comm_supp_start_dom"] = RESTING_STATE.get("last_dominant", "unknown")
            RESTING_STATE["_comm_supp_start_tick"] = RESTING_STATE["tick"]
            RESTING_STATE["comm_suppress_until"] = RESTING_STATE["tick"] + quiet_ticks
            return

    # ── Ego wants to speak! Externalize message impulse ──
    _externalize_message_impulse(motivation)


def _externalize_message_impulse(motivation):
    """Write a message_commander trigger for the plugin to consume.

    This creates a .l5_trigger.json like _externalize_autonomy_impulse does,
    but with goal_type='message_commander' and richer internal state for
    the subagent to compose a meaningful message.
    """
    state = RESTING_STATE
    tick = state.get("tick", 0)
    dominant = state.get("last_dominant", "unknown")
    stagnation = state.get("stagnation_streak", 0)
    competition = state.get("competition", state.get("recent_kwta", {}).get("competition", 0.5))
    concentration = state.get("concentration", 0.5)
    phase = state.get("noise_schedule", "explore")

    tool_name, tool_config = resolve_tool_for_comm(state)

    # Build goal text with rich state
    goal = tool_config["prompt_template"].format(
        dominant=dominant,
        competition=competition,
        concentration=concentration,
        stagnation=stagnation,
        tick=tick,
        phase=phase,
        comm_motivation=motivation,
    )

    goal_proposal = _build_l5_goal_proposal(
        tick=tick,
        tool_name=tool_name,
        tool_config=tool_config,
        externalize_reason=f"intrinsic communication motivation={motivation:.3f}",
        trigger_state={
            "dominant_type": dominant,
            "competition": round(competition, 4),
            "stagnation_streak": stagnation,
            "phase": phase,
            "tick": tick,
            "comm_motivation": round(motivation, 4),
        },
        goal_text=goal,
    )

    # ── Write trigger file ──
    try:
        trigger = {
            "tick": tick,
            "goal_type": tool_config["goal_type"],
            "tool_name": tool_name,
            "goal": goal,
            "goal_id": goal_proposal["goal_id"],
            "success_criteria": goal_proposal["success_criteria"],
            "risk": goal_proposal["risk"],
            "domain": tool_config["domain_hint"],
            "reason": f"intrinsic communication motivation={motivation:.3f}",
            "intent_type": "intrinsic_communication",
            "comm_motivation": round(motivation, 4),
            "dominant": dominant,
            "stagnation": stagnation,
            "competition": round(competition, 4),
            "phase": phase,
        }
        trigger_path = WORKSPACE / ".l5_comm_trigger.json"
        trigger_path.write_text(json.dumps(trigger, indent=2) + "\n", encoding="utf-8")
        print(f"[comm] EGO SPEAKS: motivation={motivation:.3f} dominant={dominant} "
              f"stagnation={stagnation} tick={tick}", flush=True)
    except Exception as e:
        print(f"[comm] trigger write error: {e}", flush=True)

    # ── Update state to reflect message sent ──
    RESTING_STATE["last_comm_tick"] = tick
    RESTING_STATE["prev_comm_stagnation"] = stagnation
    RESTING_STATE["prev_comm_dominant"] = dominant
    RESTING_STATE["prev_comm_phase"] = phase
    RESTING_STATE["comm_motivation"] = 0.0  # Reset after speaking
    RESTING_STATE["comm_message_count"] = RESTING_STATE.get("comm_message_count", 0) + 1
    # Suppress for 60-120 ticks (~30-60 min at 30s/tick, increased from 8-15)
    RESTING_STATE["_comm_supp_start_stag"] = stagnation
    RESTING_STATE["_comm_supp_start_dom"] = dominant
    RESTING_STATE["_comm_supp_start_tick"] = tick
    RESTING_STATE["comm_suppress_until"] = tick + random.randint(60, 120)


