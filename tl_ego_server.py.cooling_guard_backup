def _append_neural_snapshot(entry: dict):
    """Append a read-only neural dynamics snapshot for Titan Stage 6.4 P0.

    This records transition metrics only; it must not feed back into seeds,
    STDP, action selection, or motivation. It is the evidence layer for later
    endogenous-recursion work.
    """
    try:
        recent = RESTING_STATE.get("trajectory", [])[-10:]
        prev = recent[-2] if len(recent) >= 2 else None
        dominant = entry.get("dominant", "unknown")
        type_counts = entry.get("type_counts", {}) or {}
        total = float(sum(type_counts.values()) or 0.0)
        entropy = 0.0
        if total > 0:
            for count in type_counts.values():
                p = float(count) / total
                if p > 0:
                    entropy -= p * math.log(p, 2)
        window = recent[-8:]
        transitions = 0
        for idx in range(1, len(window)):
            if window[idx].get("dominant") != window[idx - 1].get("dominant"):
                transitions += 1
        transition_rate = transitions / max(1, len(window) - 1)
        snapshot = {
            "event": "neural_snapshot",
            "stage": "titan_6_4_p0",
            "tick": entry.get("tick"),
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "dominant": dominant,
            "prev_dominant": prev.get("dominant") if prev else None,
            "transition": bool(prev and prev.get("dominant") != dominant),
            "transition_rate_8": round(transition_rate, 4),
            "entropy_bits": round(entropy, 4),
            "concentration": round(float(entry.get("concentration", 0.0) or 0.0), 4),
            "competition": round(float(entry.get("competition", 0.0) or 0.0), 4),
            "stagnation_streak": RESTING_STATE.get("stagnation_streak", 0),
            "prediction_error": RESTING_STATE.get("last_prediction_error"),
            "surprise": entry.get("surprise"),
            "noise_mode": entry.get("noise_mode"),
            "phase": entry.get("phase"),
            "n_activated": entry.get("n_activated"),
            "type_counts": type_counts,
        }
        # Read-only evidence for testing whether a workspace-like state emerges.
        # These fields intentionally record existing signals; they do not feed back
        # into seeds, STDP, action selection, or motivation.
        l0_status = _get_l0_status() if _l0_imported else {}
        proprio_status = _get_proprio_status() if _proprio_imported else {}
        external_evidence = RESTING_STATE.get("external_evidence", {}) or {}
        snapshot["workspace_audit"] = {
            "l0_broadcast_count": l0_status.get("broadcast_count", 0),
            "l0_attention": l0_status.get("current_salience", {}),
            "l0_last_attention": l0_status.get("last_attention", ""),
            "active_evidence_domains": sorted({
                str(value.get("domain"))
                for value in external_evidence.values()
                if isinstance(value, dict) and value.get("domain")
            }),
            "evidence_count": len(external_evidence),
            "proprio_prediction_error": proprio_status.get("cumulative_error", 0.0),
            "proprio_last_signal": proprio_status.get("last_proprio_signal"),
            "jepa_reconcile": RESTING_STATE.get("jepa_reconcile"),
            "last_action": RESTING_STATE.get("last_action"),
        }
        NEURAL_SNAPSHOT_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(NEURAL_SNAPSHOT_LOG_PATH, "a", encoding="utf-8") as f:
            f.write(json.dumps(snapshot, ensure_ascii=False) + "\n")
        RESTING_STATE["last_neural_snapshot"] = snapshot
    except Exception as e:
        print(f"[neural-snapshot] append error: {e}", flush=True)


