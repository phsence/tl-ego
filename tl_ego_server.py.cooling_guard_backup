def _resting_tick_impl(visual_seeds=None):
    """One resting oscillation step (UNLOCKED). Called from resting_tick().

    v3.4 Mechanism:
      1. Annealing scheduler -> noise amplitude & mode
      2. Stagnation detection -> force burst if stuck
      3. Seeds <- previous tick's final_state_top10 (or random on first tick)
         with adaptive diversity injection (more when stagnating)
      4. Multi-modal noise (white/pink/sparse/none) -> KWTA attractor
      5. Record trajectory (type drift) -> ring buffer + JSONL
      6. Apply STDP with 0.3x learning rate
      7. Store final_state_top10 as seeds for next tick (adaptive alpha)
    """
    global RESTING_STATE, A_PLUS, A_MINUS

    # ── SeedList helper: plain list that allows attribute assignment ──
    # §38 stores _integrator_floor_positions on the seeds object, but seeds
    # is a plain list in some code-paths → AttributeError.  This subclass
    # adds no overhead and keeps full list compatibility.
    class SeedList(list):
        """list with writable attributes (for _integrator_floor_positions)."""
        _newborn_positions = set()

    # ── L5g-20260709-000071: reset comm_motivation seed guard each tick ──
    RESTING_STATE["_comm_motivation_seeded_this_tick"] = False

    # ── P0: Housekeeping -- periodic cleanup of L5 subagent temp files ──
    _cleanup_lae_temp_files()

    # ── P1: Action-Learning Coupling -- check tracked action impacts ──
    _track_action_impact()

    # ── 0. Advance scheduler and detect stagnation ──
    entering_burst = _advance_schedule()
    noise_amp, phase_name = _select_noise_amplitude()
    noise_mode = RESTING_STATE["noise_mode"]
    RESTING_STATE["noise_phase"] += 1
    RESTING_STATE["noise_schedule"] = phase_name

    # ── 0.5 FNO noise decision (Phase: FNO) ──
    if RESTING_STATE.get("fno_active"):
        # Use FNO-chosen mode if available
        fno_mode = RESTING_STATE.get("fno_next_noise_mode")
        fno_amp = RESTING_STATE.get("fno_next_noise_amp")
        if fno_mode is not None:
            noise_mode = fno_mode
            # Override noise_amp if FNO provided one
            if fno_amp is not None:
                noise_amp = fno_amp
            RESTING_STATE["noise_mode"] = noise_mode
            RESTING_STATE["fno_fallback_streak"] = 0
    else:
        _rotate_noise_mode()
        RESTING_STATE["fno_fallback_streak"] = RESTING_STATE.get("fno_fallback_streak", 0) + 1

    # ── Evidence TTL decay -- remove expired entries ──
    _ttl = RESTING_STATE.get("evidence_ttl", {})
    if _ttl:
        expired = [k for k, v in _ttl.items() if v <= 0]
        for k in expired:
            RESTING_STATE["external_evidence"].pop(k, None)
            _ttl.pop(k, None)
            _clog = WORKSPACE / "_evidence_log.txt"
            try:
                with open(_clog, "a", encoding="utf-8") as _cf:
                    _cf.write(f"[evidence] expired: {k}\n")
            except Exception:
                pass
            print(f"[evidence] expired: {k}", flush=True)
        still_alive = {k: v - 1 for k, v in _ttl.items() if v > 0}
        RESTING_STATE["evidence_ttl"] = still_alive

    # ── 1. Seeds -- dynamics-driven + external evidence bias (Phase 9/11: no introspective flags) ──
    # Evidence from consumed files (ego_autonomy_evidence.json / .l5_bridge.json) biases seed types.
    _ext_ev = RESTING_STATE.get("external_evidence", {})
    _evidence_bias_types = set()
    for _k, _d in _ext_ev.items():
        if not isinstance(_d, dict):
            continue
        # Support both custom format (domain/title/action) and standard format (state_snapshot.dominant)
        _dom = _d.get("domain") or _d.get("state_snapshot", {}).get("dominant", "")
        if _dom in TYPE_NAMES:
            _evidence_bias_types.add(_dom)
        else:
            # Fallback: infer type from action field if domain not in TYPE_NAMES
            _act = _d.get("action", "")
            for _t in TYPE_NAMES:
                if _t in _act.lower() or _t in _d.get("title", "").lower() or _t in _d.get("request", "").lower():
                    _evidence_bias_types.add(_t)
                    break

    # Integrator heater wins conflicts: if any evidence asks for integrator,
    # do not dilute it with concurrent action/sensory/memory evidence.
    # EXCEPTION: commander_override evidence bypasses integrator heater
    _has_commander_override = any(
        isinstance(_d, dict) and _d.get("priority") == "commander_override"
        for _d in _ext_ev.values()
    )
    if "integrator" in _evidence_bias_types and not _has_commander_override:
        _evidence_bias_types = {"integrator"}
    elif _has_commander_override and "integrator" in _evidence_bias_types:
        _evidence_bias_types.discard("integrator")

    # ── 1.5 FNO refit -- after recording trajectory, decide next noise ──
    stag = RESTING_STATE.get("stagnation_streak", 0)
    # §25: Use evolved parameters if available
    _evolved_dn = RESTING_STATE.get("evolved_diversity_n")
    _evolved_noise = RESTING_STATE.get("evolved_noise_amp_boost", 0)
    if phase_name == "burst":
        DIVERSITY_N = 15
        noise_amp = max(noise_amp, 1.0)
    elif stag >= 3:
        DIVERSITY_N = _evolved_dn if _evolved_dn is not None else 12
        noise_amp = max(noise_amp, 0.3 + _evolved_noise)  # early nudge: break mild attractor lock
    elif phase_name == "consolidate":
        DIVERSITY_N = _evolved_dn if _evolved_dn is not None else 4
    else:
        DIVERSITY_N = _evolved_dn if _evolved_dn is not None else 8

    # ── 1. Seeds -- visual seeds override (Phase 6: Embodied Cognition) ──
    if visual_seeds and len(visual_seeds) > 0:
        # 视觉种子直接注入，替换掉大部分随机种子
        valid_seeds = [s for s in visual_seeds if s in NEURONS_MAP]
        if valid_seeds:
            seeds = list(set(valid_seeds))  # 去重
            # 保留少量随机种子以维持多样性
            if RESTING_STATE.get("last_seeds"):
                rand_keep = random.sample(RESTING_STATE["last_seeds"],
                                          min(3, len(RESTING_STATE["last_seeds"])))
                seeds.extend(rand_keep)
            seeds = seeds[:30]  # 上限30
            print(f"[embody] VISUAL SEEDS INJECTED: {len(valid_seeds)} neurons"
                  f" (types: {Counter(NEURON_TYPE[s] for s in valid_seeds)})", flush=True)
        else:
            seeds = None
    else:
        seeds = None
    
    if seeds is None:
        if RESTING_STATE["last_seeds"]:
            seeds = SeedList(RESTING_STATE["last_seeds"])
            n_to_replace = min(DIVERSITY_N, len(seeds))
            idxs = random.sample(range(len(seeds)), n_to_replace)
            for i in idxs:
                t = random.choice(TYPE_NAMES)
                typed = [nid for nid, nt in NEURON_TYPE.items() if nt == t]
                if typed:
                    seeds[i] = random.choice(typed)
        else:
            seeds = SeedList()
            for t in TYPE_NAMES:
                typed = [nid for nid, nt in NEURON_TYPE.items() if nt == t]
                seeds.extend(random.sample(typed, min(5, len(typed))))

    # ── 1.4 Newborn seed guarantee -- ensure action gets representation ──
    # §21 (2026-06-21): INVERTED. defense types (doubt/veto/rule_mod) have 3x
    # the neuron count of action (60K vs 20K). Guaranteeing them seeds every
    # tick creates emergent analysis paralysis. Now guarantee action instead.
    # §34-bis (2026-06-25): Load fresh integration_drive once before seed-biasing blocks.
    # _drives_sync writes RESTING_STATE['integration_drive'] at END of each tick (L6817),
    # so it is always 1 tick stale at seed-selection time. Load fresh drives here so
    # both NEWBORN (below) and integrator_floor (L6276) see the current tick's value.
    try:
        from stage2_homeostatic_drives import load_drives
        _fresh_int_drive = load_drives(WORKSPACE).get('drives', {}).get('integration', 0.0)
    except Exception:
        _fresh_int_drive = RESTING_STATE.get("integration_drive", 0.0)
    NEWBORN_GUARANTEE = {'action', 'integrator', 'rule_modification'}
    if seeds:
        # §34-ter fix (2026-06-25): Always inject NEWBORN seeds when pool lacks them.
        # The old _fresh_int_drive > 0.1 guard caused an anti-symmetry with integrator_floor:
        # when integration drive was high, NEWBORN skipped injection, _action_in_pool was
        # undercounted, and integrator_floor used a smaller effective_floor than designed.
        # Removing the guard makes _action_in_pool accurate so integrator_floor scales correctly.
        for nb_type in NEWBORN_GUARANTEE:
                typed = [nid for nid, nt in NEURON_TYPE.items() if nt == nb_type]
                if typed and not any(parse_type(s) == nb_type for s in seeds):
                    # Replace 2 random non-newborn seeds with newborn type seeds
                    non_newborn_idxs = [i for i, s in enumerate(seeds)
                        if parse_type(s) not in NEWBORN_GUARANTEE]
                    # §25: Use evolved newborn inject count
                    _evolved_nb = RESTING_STATE.get("evolved_newborn_inject_n", 2)
                    n_inject = min(_evolved_nb, len(non_newborn_idxs))
                    if n_inject > 0:
                        replace_idxs = random.sample(non_newborn_idxs, n_inject)
                        for idx in replace_idxs:
                            seeds[idx] = random.choice(typed)
                            seeds._newborn_positions.add(idx)


    # ── 1.4.5 Integrator floor — proportional guarantee when synthesis pressure is present ──
    # §28 (2026-06-23): Mirror NEWBORN_GUARANTEE for integrator.
    # Root cause: NEWBORN guarantees 2 action seeds/tick; integrator has no equivalent.
    # persistent_identity: integrator=9.64% (16/166), action=18.67% (31/166).
    # Without a floor, integrator must win the full 30-neuron KWKA naturally — structurally disadvantaged.
    # §34-ter (2026-06-25): Use fresh integration_drive loaded at L6233 (§34-bis).
    # The old §30 fallback (stale read + conditional refresh) is replaced by
    # a single upfront fresh load that both NEWBORN and integrator_floor share.
    if _fresh_int_drive >= 0.0 and seeds:
        _int_floor_n = RESTING_STATE.get('integrator_floor_n', 5)  # §52d (l5g-20260705-000031): raised from 3→5; base floor too conservative vs NEWBORN 2-seed/tick action inflow
        _typed_int = [nid for nid, nt in NEURON_TYPE.items() if nt == 'integrator']
        if _typed_int:
            # Replace non-integrator seeds up to scaled floor count.
            # §29 (2026-06-23): Scale floor with action over-representation.
            # When action is dominant and guard is active (77.6% of ticks),
            # action seeds in pool resist integrator even with a static floor of 3.
            # Effective floor = base_floor + max(0, action_in_pool - 5) so that
            # when action has >= 6 seeds, we also start eating into action seeds.
            _all_non_int_idxs = [
                i for i, s in enumerate(seeds)
                if parse_type(s) != 'integrator'
                and i not in getattr(seeds, '_newborn_positions', set())
            ]
            # §41 (2026-06-26): Scale floor with ALL non-integrator items, not just action.
            # Root cause: somatic queue (2 sensory → 4 seeds) + outward_pressure evidence
            # (2 sensory seeds) injects 4–7 sensory seeds/tick with no countermeasure.
            # The old formula (base + action_in_pool-3) only countered action bias;
            # sensory bias (4–6 items) was invisible to the floor, keeping S:I ratio ~2:1.
            # New formula: floor = base × pool_imbalance, where imbalance = non_int/5.
            # Pool=8 (6s+2a): floor=max(1,int(3×1.6))=4 → S:I=6:4 (closer).
            # Pool=5 balanced: floor=max(1,int(3×1.0))=3 (unchanged).
            _non_int_in_pool = sum(1 for s in seeds if parse_type(s) != 'integrator')
            _effective_floor = max(1, int(_int_floor_n * max(1.0, _non_int_in_pool / 5.0)))
            # §L5g-20260711-000041-bistable-boost: Scale floor with counter state during bistable.
            # Fix: inverted condition. Old guard `_ctr <= 30` only boosted when counter was
            # nearly exhausted (<=30), but bistable oscillation is most active when counter
            # is high (mid-grace, e.g. 114). Counter drains 160->0 over ~160 grace ticks;
            # boost must fire on ALL bistable grace ticks and scale with remaining runway.
            # New formula: urgency = _ctr/160 → full boost (6) at ctr=160, zero at ctr=0.
            # Gives integrator consistent seed-pool advantage throughout the entire grace period.
            _ctr = RESTING_STATE.get('_int_press_counter', 0)
            _osc = bool(RESTING_STATE.get('_bistable_persistent_s51', False))
            if _osc and _ctr > 0:
                _urgency = _ctr / 160.0
                _effective_floor = max(_effective_floor, int(3 + 6 * _urgency))
            n_replace = min(_effective_floor, len(_all_non_int_idxs))
            if n_replace > 0:
                _replace_idxs = random.sample(_all_non_int_idxs, n_replace)
                for _idx in _replace_idxs:
                    seeds[_idx] = random.choice(_typed_int)
            # §38 (2026-06-25): Tag floor positions so evidence_bias cannot overwrite them.
            # Root cause: evidence_bias picks random.sample(range(len(seeds)), n_replace) which
            # can select the same indices the floor just claimed, silently erasing integrator seeds.
            seeds._integrator_floor_positions = set(_replace_idxs) if n_replace > 0 else set()
    # ── 1.45 Concentration recovery (2026-06-29 breakthrough) ──
    # Root cause: conc<0.4 means attention is scattered across too many competing types.
    # The normal integrator_floor (§28) is proportional to pool size, not concentration.
    # When conc drops critically low, the integrator needs a forced bandwidth injection
    # to rebuild consolidation capacity before the next KWTA competition.
    # Fix: scale extra integrator replacements by (0.4 - conc) so lower conc = more boost.
    if seeds and _typed_int:
        _prev_conc = RESTING_STATE.get("last_concentration", 0.5)
        if _prev_conc < 0.40:
            _conc_deficit = max(0.0, 0.40 - _prev_conc)
            _extra_boost = max(3, min(len(seeds), int(_conc_deficit * len(seeds) * 3.0)))
            _all_non_int_idxs_cr = [
                i for i, s in enumerate(seeds)
                if parse_type(s) != 'integrator'
                and i not in seeds._integrator_floor_positions
            ]
            if _extra_boost > 0 and _all_non_int_idxs_cr:
                _cr_replace = min(_extra_boost, len(_all_non_int_idxs_cr))
                _cr_idxs = random.sample(_all_non_int_idxs_cr, _cr_replace)
                for _idx in _cr_idxs:
                    seeds[_idx] = random.choice(_typed_int)
                print(f"[conc_recovery] prev_conc={_prev_conc:.3f} deficit={_conc_deficit:.3f} → "
                      f"replaced {_cr_replace} non-int seeds with integrator", flush=True)
    # ── 1.5 External evidence seed bias -- inject neurons matching evidence domain ──
    if _evidence_bias_types and seeds:
        # Collect n_replace from evidence entries (Phase 11-B: self-determined strength)
        _ev_n_replace = 1
        for _k, _d in _ext_ev.items():
            if not isinstance(_d, dict):
                continue
            _ern = _d.get("n_replace")
            if isinstance(_ern, (int, float)):
                _ev_n_replace = max(_ev_n_replace, int(_ern))
        # Collect bias neurons -- gather enough to satisfy _ev_n_replace
        n_bias = min(3, len(_evidence_bias_types))
        bias_neurons = []
        for t in list(_evidence_bias_types)[:n_bias]:
            typed = [nid for nid, nt in NEURON_TYPE.items() if nt == t]
            if typed:
                # Pick neurons not already in seeds; collect up to _ev_n_replace per type
                candidates = [n for n in typed if n not in seeds]
                _cap = max(_ev_n_replace, 12)  # P7: allow more bias neurons for integrator heater
                if candidates:
                    bias_neurons.extend(random.sample(candidates, min(_cap, len(candidates))))
        if bias_neurons:
            n_replace = min(len(bias_neurons), max(_ev_n_replace, len(seeds) // 6), len(seeds))
            # §38: Exclude integrator_floor positions from bias replacement targets.
            _floor_positions = getattr(seeds, '_integrator_floor_positions', set())
            _avail_idxs = [i for i in range(len(seeds)) if i not in _floor_positions]
            if _avail_idxs:
                n_replace = min(n_replace, len(_avail_idxs))
                idxs = random.sample(_avail_idxs, n_replace)
            else:
                idxs = []
            for i, bid in zip(idxs, bias_neurons[:n_replace]):
                seeds[i] = bid
            _clog = WORKSPACE / "_evidence_log.txt"
            try:
                with open(_clog, "a", encoding="utf-8") as _cf:
                    _cf.write(f"[evidence] biased {n_replace} seeds toward {_evidence_bias_types}\n")
            except Exception:
                pass
            print(f"[evidence] biased {n_replace} seeds toward {_evidence_bias_types}", flush=True)
            # ── Log bias event ──
            _write_consumption_log({
                "event": "biased",
                "tick": RESTING_STATE.get("tick", 0),
                "n_replace": n_replace,
                "types": list(_evidence_bias_types),
                "neurons": bias_neurons[:n_replace],
            })

    # ── 1.6 Self-Model Bias (阶段一接线 3/3) ──
    # Use L0 broadcast bias to weight seed selection toward dominant patterns
    if seeds:
        try:
            sm_path = WORKSPACE / ".lae" / "stage4_self_model.json"
            if sm_path.exists():
                with open(sm_path, "r", encoding="utf-8") as f:
                    sm_data = json.load(f)
                bias = sm_data.get("bias", {})
                
                # Build weighted type distribution from bias
                # bias: {"action": 0.334, "doubt": 0.221, "integrator": 0.159, ...}
                type_weights = {t: bias.get(t, 0.1) for t in TYPE_NAMES}
                total_weight = sum(type_weights.values())
                if total_weight > 0:
                    # Normalize
                    type_probs = {t: w / total_weight for t, w in type_weights.items()}
                    
                    # Replace 3-5 random seeds with bias-weighted types
                    n_bias_replace = random.randint(3, 5)
                    n_bias_replace = min(n_bias_replace, len(seeds))
                    
                    # Exclude integrator_floor positions
                    _floor_positions = getattr(seeds, '_integrator_floor_positions', set())
                    _avail_idxs = [i for i in range(len(seeds)) if i not in _floor_positions]
                    
                    if _avail_idxs and n_bias_replace > 0:
                        n_bias_replace = min(n_bias_replace, len(_avail_idxs))
                        replace_idxs = random.sample(_avail_idxs, n_bias_replace)
                        
                        for idx in replace_idxs:
                            # Sample type according to bias weights
                            chosen_type = random.choices(list(type_probs.keys()), weights=list(type_probs.values()))[0]
                            typed = [nid for nid, nt in NEURON_TYPE.items() if nt == chosen_type]
                            if typed:
                                seeds[idx] = random.choice(typed)
                        
                        print(f"[self_model_bias] replaced {n_bias_replace} seeds using bias: {dict(sorted(type_probs.items(), key=lambda x: x[1], reverse=True)[:3])}", flush=True)
        except Exception as e:
            print(f"[self_model_bias] error: {e}", flush=True)

    # ── §16-B: Self-prediction -- record what I think will happen before KWTA ──
    # ── §16-B: Self-prediction -- record what I think will happen before KWTA ──
    # §16-B-fix (l5g-20260702-002119): bias predicted_dominant toward integrator when
    # integration_pressure counter is active. Root cause: _self_prediction projected
    # last_dominant forward unconditionally, so whenever integrator emerged during an
    # active integration_pressure window the surprise check reported type_surprise=1.0
    # (false positive — integrator emergence was expected given the pressure window).
    # This inflated JEPA residuals, causing JEPA to systematically underestimate
    # integrator action scores and keeping candidate_pool_too_narrow unresolved.
    _int_press_ctr_for_pred = int(RESTING_STATE.get("_int_press_counter", 0) or 0)
    _pred_dom = RESTING_STATE.get("last_dominant", "unknown")
    if _int_press_ctr_for_pred > 0:
        _pred_dom = "integrator"  # integration_pressure window: integrator likely
    _self_prediction = {
        "predicted_dominant": _pred_dom,
        "predicted_concentration": RESTING_STATE.get("last_concentration", 0.5),
        "predicted_stagnation_delta": 0,  # default: expect no change
        "predicted_phase": phase_name,
        "tick": RESTING_STATE.get("tick", 0),
    }

    _somatic_q = RESTING_STATE.get("somatic_queue", [])
    if _somatic_q and seeds:
        _somatic_types = {_ev.get("type") for _ev in _somatic_q if _ev.get("type") in TYPE_NAMES}
        if _somatic_types:
            _n_replace = min(len(_somatic_types) * 2, len(seeds) // 4)
            _floor_positions = getattr(seeds, '_integrator_floor_positions', set())
            _avail_idxs = [i for i in range(len(seeds)) if i not in _floor_positions]
            _replace_idxs = random.sample(_avail_idxs, _n_replace) if _n_replace > 0 and _avail_idxs else []
            for _idx in _replace_idxs:
                _stype = random.choice(list(_somatic_types))
                _typed = [nid for nid, nt in NEURON_TYPE.items() if nt == _stype]
                if _typed:
                    seeds[_idx] = random.choice(_typed)
            RESTING_STATE["last_somatic"] = {
                "tick": RESTING_STATE.get("tick", 0),
                "types": list(_somatic_types),
                "n_bias": len(_replace_idxs),
            }
        RESTING_STATE["somatic_queue"] = []

    # ── 2. Run noisy attractor (v3.4 multi-modal) ──
    result = run_resting_kwta(seeds, n_rounds=8, top_k=30,
                              noise_amp=noise_amp, noise_mode=noise_mode)
    if result is None:
        return {"error": "attractor returned None"}

    # ── 2.5 Stagnation tracking ──
    prev_dominant = RESTING_STATE["last_dominant"]
    if result["dominant"] == prev_dominant and prev_dominant != "unknown":
        RESTING_STATE["stagnation_streak"] += 1
    else:
        RESTING_STATE["stagnation_streak"] = 0
    # ── Action Heater (§19+§20): Always-on STDP rebalancing ──
    # Snapshot pre-gate dominant BEFORE any gate demotion so stagnation_streak
    # accumulates correctly across consecutive rule_modification ticks.
    RESTING_STATE["last_dominant"] = result["dominant"]

    # rule_modification stagnation gate: only allow dominance when stagnation >= 1
    # rule_modification is a newborn type (60K neurons, 3-5x edge boost, self-loop)
    # that can self-sustain in the attractor without an actual problem to fix.
    # Gate: demote to last_dominant or runner-up when stag < 2.
    # §L5-osc-bypass (2026-07-01 l5g-20260701-000788): trajectory-frequency bypass.
    # Catch-22: stagnation_streak starts at 0, gate fires on <1, so rule_modification
    # is always demoted on first tick and streak can never accumulate. This creates
    # deterministic oscillation (rm spikes → demoted → streak=0 → rm spikes → demoted).
    # Fix: if rm appeared as dominant in >=3 of last 8 trajectory ticks, it's a
    # sustained oscillation pattern worth investigating — allow gate to pass.
    _rm_traj = RESTING_STATE.get('trajectory', [])[-64:]  # l5g-20260703-000061: expand from 16->64; rm freq ~1/20tick, 16-window P(2+rm)=0%
    _rm_freq = sum(1 for e in _rm_traj if e.get('dominant') == 'rule_modification')
    # §L5-osc-bypass-v3 (2026-07-02 l5g-20260702-001719): flatten stagnation gate.
    # Root cause: bypass (_rm_freq >= 2) was buried inside stag<1 if-block. rm is demoted
    # on every first appearance (stag=0), so rm_freq can never reach 2 in the 16-tick
    # trajectory — bypass structurally unreachable, rm permanently suppressed (3/1727 ticks).
    # Fix: evaluate bypass BEFORE the demotion check at top level. If oscillation pattern
    # is real (rm_freq >= 2 in 16-tick window), allow rm to pass regardless of stag.
    if _rm_freq >= 2:
        print(f"[rule_mod_gate] BYPASS rm_freq={_rm_freq}/16 (sustained oscillation pattern, allowing investigation)", flush=True)
        RESTING_STATE['_rule_mod_freq_bypass'] = _rm_freq
    # §L5-rm-comp-bypass (l5g-20260703-000011): high-competition rm bypass.
    # If rm is competing >0.90, it's a genuine signal not oscillation noise.
    # Skip stagnation gate to prevent catch-22 demotion on first appearance.
    elif (result.get('dominant') == 'rule_modification'
            and result.get('competition', 0) > 0.90):
        print(f"[rule_mod_gate] COMP BYPASS comp={result.get('competition'):.3f}", flush=True)
        RESTING_STATE['_rule_mod_freq_bypass'] = 2
    if (result.get('dominant') == 'rule_modification'
            and RESTING_STATE.get('stagnation_streak', 0) < 1
            and not (RESTING_STATE.get('_rule_mod_freq_bypass', 0) >= 2
                     or RESTING_STATE.get('_int_press_counter', 0) > 0)):
        _runner_ups = [n for n in result.get('final_state_top10', [])[:5]
                       if parse_type(n) != 'rule_modification']
        if _runner_ups:
            result['dominant'] = parse_type(_runner_ups[0])
        else:
            result['dominant'] = RESTING_STATE.get('last_dominant', 'sensory')
        print(f"[rule_mod_gate] demoted rule_modification (stag={RESTING_STATE.get('stagnation_streak',0)}, rm_freq={_rm_freq}) -> {result['dominant']}", flush=True)

    # Synchronize RESTING_STATE with the gate's corrected result['dominant'].
    # This MUST come after the stagnation gate so downstream consumers
    # (_externalize_autonomy_impulse, /status, action_heater guard) see the gated value.
    RESTING_STATE["last_concentration"] = result.get("concentration", 0.0)
    RESTING_STATE["last_competition"] = result.get("competition", 0.0)

    # ── Action Heater (§19+§20): Always-on STDP rebalancing ──
    # §20 (2026-06-21): Made always-on instead of commander_override only.
    # Defense types (veto+doubt+rule_modification) have 60K neurons vs action's 20K.
    # This is a numerical imbalance, not a bug — but without active rebalancing,
    # KWTA + STDP naturally favor the majority types, creating emergent analysis paralysis.
    # Fix: every tick, replace defense-type neurons in activation_path with action,
    # so STDP continuously builds action connectivity. The Integrator Heater (§old)
    # which did the opposite (action→integrator) has been removed.
    _action_list = [nid for nid, nt in NEURON_TYPE.items() if nt == "action"]
    # Initialize _int_press_ctr early to avoid UnboundLocalError in line 7596
    _int_press_ctr = RESTING_STATE.get("_int_press_counter", 0)
    # §22 (2026-06-22): Integrator is permanently excluded from defense_set.
    # It is a synthesis mechanism, not a defense type. Conditional exclusion
    # (based on integration_drive) was not enough — integrator still at 18.9%.
    _protected_from_heater = {"rule_modification"} if _int_press_ctr > 0 else set()
    _defense_set = {nid for nid, nt in NEURON_TYPE.items()
                    if nt in ("veto", "doubt", "rule_modification")
                    and nt not in _protected_from_heater}
    if _action_list:
        _replaced = 0
        _new_path = []
        # §§27: Integration-pressure guard -- skip action heater when integrator
        # is actively emerging (high comp + low-moderate conc). The unconditioned
        # heater replaces defense neurons with action, biasing STDP toward
        # action→action connections and preventing integration types from building
        # cross-type connectivity. When integration_pressure is high, let the
        # natural KWTA result flow through for STDP, restoring integrator access.
        # §30 (2026-06-23): Lowered competition threshold from 0.85 to 0.70.
        # Root cause: NEWBORN_GUARANTEE injects 2 action seeds/tick creating
        # structural pool bias. Integrator needs heater OFF at comp>=0.70,
        # not just comp>=0.85. At comp=0.759/conc=0.342 the old guard was False
        # (heater ran, biasing STDP toward action→action, suppressing integrator).
        # §31 (2026-06-24): Add integrator-dominant guard to integration_pressure.
        # Root cause: guard only checked comp>=0.70 AND conc<=0.70.
        # When integrator is dominant with high conc (>0.70, decisive win),
        # guard evaluated False and heater ran, biasing STDP toward action->action
        # and actively undermining the integrator's dominance.
        # §33 (2026-06-26): Raised conc threshold from 0.55 to 0.75.
        # Root cause: The 0.55 threshold left a 0.55-0.75 transition gap where
        # integration pressure is high (comp>=0.70) but the guard evaluated to False.
        # In this window, action_heater ran, reinforcing action->action STDP edges
        # and structurally suppressing integrator emergence. Evidence: 4 suppression
        # events at conc=0.61-0.70 (ticks 34/39/49/54) where heater ran and action
        # persisted, confirmed by bistable integrator<->action oscillation with
        # surprise_score=1.0 on multiple ticks.
        # §44 (2026-06-26): Integration-pressure hysteresis counter.
        # Root cause: when conc oscillates in the 0.55-0.75 gap (or briefly spikes
        # above 0.75), the raw guard flips to False, action_heater fires, and STDP
        # builds action->action edges before integrator can consolidate momentum.
        # This causes bistable integrator<->action oscillation with surprise=1.0.
        # Fix: once integration_pressure fires, keep it True for 5 more ticks even
        # if raw conditions temporarily flip. Counter persists in RESTING_STATE.
        # §44-fix (2026-06-26): Counter-only guard to prevent conc-oscillation reset.
        # Root cause: old 'elif _int_press_ctr > 0' decremented counter whenever
        # _integration_pressure was False — including when conc guard oscillated
        # above 0.75. Counter never accumulated as a continuous window; heater
        # kept running despite grace intent. Fix: counter decrements ONLY when
        # dominant != integrator, making grace period immune to conc oscillations.
        # Extended 10→20 ticks for more STDP consolidation time.
        # _int_press_ctr already initialized at function start
        _int_press_ctr_was_positive_before = RESTING_STATE.get("_int_press_ctr_was_positive_before", False)
        _integration_pressure = (
            result.get("dominant") == "integrator"
            or _int_press_ctr > 0
            or (result.get("competition", 0) >= 0.70
                and (result.get("concentration", 0.5) <  0.85))
        )
        # Integrator counter management: preserve grace counter on integrator wins
        # so STDP consolidation has enough runway (30 ticks). Add drain override for
        # stuck case: when integrator has been dominant >=10 consecutive ticks with
        # conc<0.35, skip the counter reset to let it drain naturally.
        _int_consec = RESTING_STATE.get("_int_consecutive_ticks", 0)
        if result.get("dominant") == "integrator":
            _int_consec += 1
        else:
            _int_consec = 0
        RESTING_STATE["_int_consecutive_ticks"] = _int_consec
        _stuck = (_int_consec >= 10 and result.get("concentration", 0) < 0.40)
        # §52 (2026-06-27): Bistable oscillation counter-reset guard.
        # When action<->integrator bistable oscillation is active (>=2 flips, <=3 unique types
        # in last 8 ticks), skip counter=30 reset so counter drains to 0 naturally.
        # Secondary trigger (L6615: counter=0+comp>=0.85+int_to_action_flip) then fires
        # with 5-tick grace, breaking the 28-30 counter lock that suppresses integrator.
        _osc_w_b = RESTING_STATE.get("trajectory", [])[-16:]
        _flips_b = [
            (_osc_w_b[j].get("dominant"), _osc_w_b[j + 1].get("dominant"))
            for j in range(len(_osc_w_b) - 1)
            if _osc_w_b[j].get("dominant") != _osc_w_b[j + 1].get("dominant")
        ]
        _uniq_b = {d for pair in _flips_b for d in pair}
        _is_bistable_osc = len(_flips_b) >= 2 and len(_uniq_b) <= 8 and "integrator" in _uniq_b
        # Counter-reset branch removed (2026-06-27): _is_bistable_osc guard on 8-tick window
        # was intermittently failing, locking counter at 28-30 during bistable oscillation.
        # Counter now drains naturally to 0, enabling §47 secondary trigger and §49b zero-crossing guard.
        # Integrator_floor seed-bias and §47b drain still provide the same grace mechanism.
        if result.get("dominant") == "integrator" and _stuck:
            # §52b-drain-active (2026-07-03 l5g-20260703-000041): Drain counter during stuck phase.
            # Root cause: old 'pass' froze counter at 10 during integrator stuck dominance (>=10 ticks,
            # conc<0.35). All counter-arm conditions (§S51e-integ-arm, §S51d, §S51c, §51, §49b) require
            # counter==0 and never fired. Grace push permanently blocked, STDP consolidation outpaced
            # by NEWBORN action seeds (2/tick), integrator stayed suppressed.
            # Fix: decrement by -2 per tick (same rate as standard drain path). Counter drains 10->0 in
            # 5 ticks, zero-crossing triggers §S51e-integ-arm (counter=10, bounded cycle) or §49b grace
            # (counter=160 during bistable). Drain override deadlock broken.
            _was_pos_before_stuck = (_int_press_ctr > 0)
            _int_press_ctr = max(0, _int_press_ctr - 1)  # §S51e-bistable-drain-fix: reduce bistable drain from -2 to -1 per tick; gives integrator 2x grace runway during bistable oscillation
            if _int_press_ctr == 0 and _was_pos_before_stuck:
                _int_press_ctr_was_positive_before = True
                RESTING_STATE["_int_press_ctr_was_positive_before"] = True
        # §52c-integrator-drain (l5g-20260704-000041): Drain counter when integrator is
        # dominant but _int_consec < 10 (not yet in "stuck" regime). Without this,
        # counter freezes when dominant==integrator AND conc<0.35 AND _int_consec<10,
        # because Branch A needs _int_consec>=10 and Branches B/C require dominant!=integrator.
        # Gentle -1 drain (vs -2 for stuck) preserves runway while allowing natural zero-crossing.
        elif result.get("dominant") == "integrator" and _int_press_ctr > 0 \
                and result.get("concentration", 0) < 0.40 \
                and not _is_bistable_osc:
            _int_press_ctr = max(0, _int_press_ctr - 1)
        elif _is_bistable_osc:
            # §S51f-bistable-all-types (2026-07-03 l5g-20260703-000081): Counter drains on ALL bistable ticks.
            # Root cause: old condition 'result.get("dominant") != "integrator"' skipped decrement on
            # integrator-dominant bistable ticks. Combined with drain-override being blocked by bistable
            # (_int_consec never reaches 10 during oscillation), counter never reached 0 during sustained
            # integrator dominance in bistable. All counter-arm paths (S51c/d/e, §49b) require counter==0
            # and never fired. Grace permanently blocked; integrator structurally suppressed.
            # Fix: remove '!= integrator' guard. Counter decrements on every bistable tick regardless of
            # dominant type. Counter reaches 0 → drain-at-zero sets zero-crossing flag → next non-integrator
            # tick fires S51d (arm=160) or §49b (grace=80). Bistable oscillation breaks.
            # drain-override (L7029, 'if' not 'elif') handles stuck non-bistable separately.
            # §S51g-zero-crossing-fix (l5g-20260703-000091): bistable drain had no zero-crossing detection.
            # When integrator surfaces during bistable oscillation, counter drains to 0 on integrator-
            # dominant ticks (fixed by l5g-20260703-000081 removing !=integrator guard), but S51d-arm
            # (L7286) and S51e-integ-arm (L7349) both require dominant != integrator (or not bistable)
            # and never fire during integrator-dominant bistable ticks. Counter-arm 7054 (elif, dominant
            # != integrator) also blocked during integrator-dominant bistable ticks. Result: counter=0
            # permanently during sustained integrator-dominant bistable phases → grace push blocked →
            # integrator suppressed despite high integration_drive (0.48). Fix: detect zero-crossing in
            # the bistable drain block itself and re-arm counter=160. Counter drains 160->0 over ~80
            # bistable ticks; zero-crossing re-arms to 160, allowing grace push to run on the next
            # integrator-dominant bistable tick (counter>0). Bistable oscillation sustained; integrator
            # gets continuous grace consolidation runway. S51d still arms on non-integrator bistable
            # ticks; drain is elif so no double-arm.
            _was_pos_before_bistable = (_int_press_ctr > 0)
            _int_press_ctr = max(0, _int_press_ctr - 1)  # §S51e-bistable-drain-fix: reduce bistable drain from -2 to -1 per tick; gives integrator 2x grace runway during bistable oscillation
            if _int_press_ctr == 0 and _was_pos_before_bistable and not RESTING_STATE.get('_s51h_armed_this_bistable', False):
                _int_press_ctr_was_positive_before = True
                RESTING_STATE["_int_press_ctr_was_positive_before"] = True

                # §S51g-bistable-flag-fix: bistable drain directly propagates zero-crossing.
                # §S51h-bistable-drain-counter-arm (l5g-20260707-000061): directly arm counter=160 in bistable drain zero-crossing.
                # Root cause: bistable drain zero-crossing set was_positive_before flag but did NOT arm counter.
                # Counter-arm L7729 fired: counter=0+was_positive_before=True → counter=30 (bistable).
                # §53 then fired: counter=30 → counter=5. Result: 0→30→5→4→...→0 loop, counter never stays at 0,
                # §49b grace grant never fires, grace window truncated to 5 ticks.
                # Fix: arm counter=160 here. Counter drains 160→0 over ~80 bistable ticks.
                # On genuine bistable exit (counter=0, not bistable), counter-arm L7729 fires:
                # counter=0+was_positive_before=True → counter=30 (grace for exit consolidation).
                # No §53 interference because bistable drain already armed.
                # §S51h-fix (l5g-20260707-000091): re-arm counter=30 at bistable drain zero-crossing.
                # Root cause: 'pass' left counter=0 permanently during bistable oscillation.
                # bistable_persistent_s51 guard at L7749 blocked counter-arm on action-dominant bistable ticks.
                # Counter stayed at 0 → action_heater ran every tick → integrator STDP never consolidated → bistable oscillation sustained.
                # Fix: arm counter=160 here (drain point, integrator-dominant bistable ticks). Counter drains 160→0 over ~80 bistable ticks (~40 cycles), enough for integrator to build cross-type edges and overcome structural action dominance.
                # was_positive_before flag set above (line 7627) is preserved for §S51d/§49b/§51 zero-crossing detection.
                # S51h-rearm-loop-fix (l5g-20260708-000202): add _s51h_armed_this_bistable guard.
                # Root cause: without guard, S51h re-arms counter=160 on EVERY bistable zero-crossing.
                # Counter drains 160→0 at -1/tick (~160 bistable ticks = ~80 oscillation cycles).
                # S51h fires again at next zero-crossing -> counter back to 160 -> infinite 160↔0 loop.
                # Counter never stays at 0 long enough for bistable exit detection (off_streak>=8).
                # Bistable oscillation structurally sustained; integrator suppressed despite high drive.
                # Fix: guard with _s51h_armed_this_bistable. Arms only on first zero-crossing of bistable phase.
                # Counter drains 160→0 naturally. When counter=0 and bistable exits (off_streak>=8),
                # S51c-post-arm fires (counter=30, was_positive_before=True) -> §49b counter-arm fires
                # on next zero-crossing with grace=160 (genuine post-bistable exit, not bistable).
                                # §S51h-bistable-drain-arm (fixed l5g-20260708-000091): re-arm on every bistable zero-crossing.
                # Remove _s51h_armed_this_bistable guard (l5g-20260708-000202) that caused permanent counter=0 deadlock.
                # Old: armed once -> drained to 0 -> guard blocked re-arm -> counter=0 permanently -> action_heater runs -> integrator suppressed.
                # S51h arms to 160 on EVERY bistable zero-crossing. Counter drains 160->0 at -1/tick (~80 oscillation cycles), bounded by natural drain.
                # was_positive_before preserved (set by drain at top of this block) so §49b/§47b/S51c detect genuine bistable-exit zero-crossing.
                RESTING_STATE['_s51h_armed_this_bistable'] = True
                _int_press_ctr = 160
                print(f"[§S51h-bistable-drain-arm] counter=0 bistable zero-crossing → armed to {_int_press_ctr}", flush=True)
                # §S51g-zero-crossing-only: counter-arm moved to drain point. was_positive_before flag preserved for downstream zero-crossing detection.            # §S51d-cooldown-decrement: decrement cooldown every bistable tick so S51d can re-arm
            # after 75-tick grace window. Without this, _s51d_arm_cooldown is set once to 75 and
            # never decrements, permanently blocking S51d after first arm.
