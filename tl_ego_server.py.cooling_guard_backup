def _append_live_affordance_snapshot(*, tick: int, ego_state: dict, observation: dict, affordances: list):
    """Persist the pre-ranking live candidate pool without affecting selection."""
    try:
        candidates = json.loads(json.dumps(
            list(affordances or [])[:LIVE_AFFORDANCE_MAX_ITEMS],
            ensure_ascii=False,
        ))
        entry = {
            "event": "live_affordance_snapshot",
            "schema_version": 1,
            "stage": "post_counterfactual_pre_jepa",
            "tick": int(tick),
            "state_t": {
                "dominant_type": ego_state.get("dominant_type"),
                "stagnation_streak": ego_state.get("stagnation_streak"),
                "competition": ego_state.get("competition"),
                "concentration": ego_state.get("concentration"),
                "prediction_error": ego_state.get("prediction_error"),
            },
            "observation_t": {
                "status": observation.get("status"),
                "count": observation.get("count", 0),
                "categories": observation.get("categories", {}),
                "residual_defect": observation.get("residual_defect"),
                "counterfactual_generator": observation.get("counterfactual_generator"),
            },
            "candidate_count": len(candidates),
            "candidate_count_before_cap": len(affordances or []),
            "candidates": candidates,
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        payload = json.dumps(entry, ensure_ascii=False, separators=(",", ":"))
        if len(payload.encode("utf-8")) > LIVE_AFFORDANCE_MAX_BYTES:
            print("[affordance-snapshot] skipped oversized snapshot", flush=True)
            return None
        LIVE_AFFORDANCE_SNAPSHOT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LIVE_AFFORDANCE_SNAPSHOT_LOG, "a", encoding="utf-8") as f:
            f.write(payload + "\n")
        return entry
    except Exception as e:
        print(f"[affordance-snapshot] append error: {e}", flush=True)
        return None


