# ego.env — TL-Ego runtime config fallback (l5g-20260921-020351)
#
# WHY THIS EXISTS: scripts/l5_apply_repair.ps1 restarts TL-Ego with a bare
# `Start-Process python tl_ego_server.py`, bypassing run_tlego_service.bat, so
# every EGO_* var set in the bat was silently lost on each L5 self-repair
# restart. The server now reads this file (os.environ.setdefault, so real env
# vars always win) so every launch path converges on one config.
#
# Keep values in sync with projects/tl-ego/run_tlego_service.bat. No secrets
# here — the LLM key comes from ego_key.txt (see _load_llm_api_key).

# GPU attractor: AttractorNetworkGpu, ~7x faster at 100k scale; auto CPU fallback
EGO_GPU_KWTA=1
# GPU SNN hot-pool sidecar (real LIF + ms-scale time-difference STDP; bypassed on any error)
EGO_GPU_SNN=1
# LTP balance: 0 = restore old 0.95 gain (structurally biased toward forgetting,
# historically put 64% of edges on the pruning line)
EGO_LTP_GAIN=4.0
# Predictive-plasticity transfer table persistence (no var = memory only, reset on restart)
EGO_PRED_STATE=C:\Users\Administrator\.openclaw\workspace\.lae\predictive_plasticity.json
# 2026-09-11 A/B: integrator_suppression_repair had no discriminative power
# (arming detector fired on 73.6% of real windows AND 100% of shuffled null)
EGO_REPAIR_TOOL=0
# 2026-10-30: 大脑模型 step-3.5-flash -> step-5-preview (用户拍板"换stepfun 5")。
# step-5-preview 默认深思会烧光 max_tokens, 由 ego_llm_gate 统一压 effort=low (EGO_LLM_REASONING 可覆盖)。
EGO_LLM_MODEL=step-5-preview

# ── 2026-11-10: goal focus 配置落到这里 (与 run_tlego_service.bat 同步) ──
#  WHY: ego_keepalive.py(Hermes cron 看门狗) 直接 spawn python, 不带 bat 的 env;
#  这些变量此前只存在于 bat 里 -> 每次看门狗拉活都静默丢失整套 focus 配置
#  (自进化类型冷却退回 7200s, 被降级的杂活全部回流)。ego.env 由服务器
#  setdefault 读取, 是唯一所有启动路径都收敛的配置点。
# 2026-11-10: decider_deliberate 已移出 FOCUS — decision_record.json 全库零消费者,
#  决策不改变行为(只经 result.json 交接段影响下一个 goal), 100% 成功率是 vanity
#  指标。移出后回到 7200s 常规冷却; decider 簇 dominant 时仍可自然派发。
EGO_GOAL_DEMOTE=create_video,memory_recall,stock_investment,workspace_assist,explore_external,web_search,query_memorybus,knowledge_retrieve,sensory_explore,action_execute,ego_arena_select,run_quantum_experiment
EGO_GOAL_FOCUS=rule_modification_repair,causal_lens,deep_probe_unstable,synthesize_novel_concept,knowledge_upgrade,architect_capability_design,integrator_synthesize,imagine_alternatives,curiosity_explore,consciousness_awakening
# 2026-11-10: 300->900s. 实测供给 5.1 goal/h vs 执行器吞吐 ~5/h, 积压 48 个
# 未派发 goal (consciousness 5 个全堵在 block 里)。冷却放宽到 15min 砍 focus 供给 ~3x,
# 让积压排干、每个 goal 在状态还新鲜时跑完。回滚: 改回 300。
EGO_FOCUS_COOLDOWN_SEC=900
