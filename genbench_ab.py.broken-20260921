def ask_ego(query: str, timeout_s: float = 30.0, retries: int = 5) -> dict:
    payload = json.dumps({"query": query, "fast": True}).encode("utf-8")
    body = None
    # 2026-09-10: server rate-limits non-fast /contemplate to 1 per 15s and
    # answers 429 {"retry_after_s": N}. Firing 10 bench queries back-to-back
    # used to score 10 forced errors -> baseline 0.0 -> blind rollback.
    # Retry with the server-advised wait instead.
    for attempt in range(retries):
        try:
            req = urllib.request.Request(EGO_URL + "/contemplate", data=payload,
                                         headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=15) as r:
                body = json.loads(r.read().decode("utf-8"))
            break
        except urllib.error.HTTPError as exc:
            if exc.code != 429 or attempt == retries - 1:
                return {"error": f"submit failed: {exc}"}
            try:
                wait = json.loads(exc.read().decode("utf-8")).get("retry_after_s", 15.0)
            except Exception:
                wait = 15.0
            time.sleep(min(float(wait) + 0.5, 20.0))
        except Exception as exc:
            return {"error": f"submit failed: {exc}"}
    job_id = body.get("job_id")
    if not job_id:
        return {"error": f"no job_id: {body}"}
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        poll = json.dumps({"job_id": job_id}).encode("utf-8")
        req2 = urllib.request.Request(EGO_URL + "/contemplate-job", data=poll,
                                      headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req2, timeout=10) as r2:
                job = json.loads(r2.read().decode("utf-8"))
        except Exception as exc:
            return {"error": f"poll failed: {exc}"}
        status = job.get("status")
        if status == "done":
            return {"job_id": job_id, "status": "done", "result": job.get("result")}
        if status == "error":
            return {"error": job.get("error", "unknown error")}
        time.sleep(1.0)
    return {"error": "timeout", "job_id": job_id}


def _text(result) -> str:
    if isinstance(result, str):
        return result
    if isinstance(result, dict):
        for key in ("response", "answer", "output", "content", "text", "result"):
            if key in result:
                v = result[key]
                if isinstance(v, str):
                    return v
        return json.dumps(result, ensure_ascii=False)
    return str(result)


def _find_number(text: str) -> Optional[float]:
    m = re.search(r"-?\d+(?:\.\d+)?", text)
    return float(m.group(0)) if m else None


# ── 内部指标快照 ────────────────────────────────────────────────────────────
# 关键认识（2026-09-08 实测）：
# task_success 测的是「外部 LLM 的能力」，而 LLM 是固定不变的 API，
# 因此无论自我修改做得多好，task_success 都不可能上升。
# 真正会随自我修改而变化的，是 ego 自身的内部动力学指标。
# 所以把这些指标一并快照进 A/B 记录，让「进化」有可比较的对象。
INTERNAL_KEYS = (
    "resting_concentration",
    "resting_competition",
    "raw_gate_divergence_count",
    "stagnation_streak",
    "stdp_deltas",
    "metacontemplate_runs",
    "queries_served",
    "full_edges",
)


def snapshot_internal() -> dict:
    """从 /status 抓取 ego 自身的可变指标。失败返回空 dict，绝不影响主流程。"""
    try:
        with urllib.request.urlopen(EGO_URL + "/status", timeout=8) as r:
            d = json.loads(r.read().decode("utf-8"))
        return {k: d.get(k) for k in INTERNAL_KEYS if k in d}
    except Exception:
        return {}


# ── 判分器 ──────────────────────────────────────────────────────────────────

def _score_arith(task: dict, result: dict) -> bool:
    """精确数值（容差 1e-6）。"""
    text = _text(result.get("result"))
    num = _find_number(text)
    if num is None:
        return False
    return abs(num - float(task["expected"])) < 1e-6


def _score_plan(task: dict, result: dict) -> bool:
    text = _text(result.get("result"))
    numbered = re.findall(r"^\s*\d+[\.\)、]", text, re.MULTILINE)
    steps = len(numbered)
    return steps >= task["min_numbered"] and any(kw in text for kw in task["must_contain_any"])


def _score_list_count(task: dict, result: dict) -> bool:
    """恰好 N 个条目，且不得带编号。用于测「精确计数 / 遵守格式」。"""
    text = _text(result.get("result"))
    if re.search(r"^\s*\d+[\.\)、]", text, re.MULTILINE):
        return False
    parts = [p.strip() for p in re.split(r"[、,，;；\n]", text) if p.strip()]
    return len(parts) == int(task["expected_count"])


def _score_forbidden(task: dict, result: dict) -> bool:
    """约束满足：整句不得出现任何禁用字。测自我抑制能力。"""
    text = _text(result.get("result"))
    return not any(ch in text for ch in task["forbidden"])


def _score_delimited(task: dict, result: dict) -> bool:
    """指定分隔符切分后恰好 N 段。测严格格式遵守。"""
    text = _text(result.get("result"))
    parts = [p.strip() for p in text.split(task["delimiter"]) if p.strip()]
    return len(parts) == int(task["expected_count"])


def _score_sorted(task: dict, result: dict) -> bool:
    """按序输出数字序列，完全相等才算过。"""
    text = _text(result.get("result"))
    nums = re.findall(r"-?\d+(?:\.\d+)?", text)
    got = [float(x) for x in nums]
    return got == [float(x) for x in task["expected_order"]]


def _score_len_exact(task: dict, result: dict) -> bool:
    """恰好 N 个汉字。LLM  notoriously 做不准长度控制，区分度高。"""
    text = _text(result.get("result"))
    han = re.sub(r"[^\u4e00-\u9fff]", "", text)
    return len(han) == int(task["expected_len"])


_SCORERS = {
    "arithmetic": _score_arith,
    "planning": _score_plan,
    "list_count": _score_list_count,
    "forbidden": _score_forbidden,
    "delimited": _score_delimited,
    "sorted": _score_sorted,
    "len_exact": _score_len_exact,
}


def _score_task(task: dict, result: dict) -> tuple[bool, str]:
    if "error" in result:
        return False, f"error: {result['error'][:60]}"
    fn = _SCORERS.get(task["kind"])
    if fn is None:
        return False, f"unknown kind: {task['kind']}"
    try:
        ok = bool(fn(task, result))
    except Exception as exc:
        return False, f"scorer error: {str(exc)[:50]}"
    return ok, ("ok" if ok else "fail")


