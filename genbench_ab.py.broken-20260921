def score_alert(current: float, previous: Optional[float]) -> tuple[float, str]:
    """Compare current baseline vs previous. Return (delta, alert_msg).

    delta = current - previous  (负数表示能力下降)
    alert_msg:
      "first_run"  - 没有 previous（含题库换版导致的基线失效）
      "stable"     - 差 < 阈值
      "improved"   - 涨 >= 阈值
      "degraded"   - 跌 >= 阈值 (报警)
    """
    if previous is None:
        return 0.0, "first_run"
    delta = round(current - previous, 6)
    if delta >= ALERT_THRESHOLD:
        return delta, "improved"
    elif delta <= -ALERT_THRESHOLD:
        return delta, "degraded"
    else:
        return delta, "stable"


def _entry_measured(entry) -> bool:
    """True if the ab entry reflects real measurements (not all-transport-fail)."""
    return bool(entry.get("measured", True))



def ab_validate(proposal_id: Optional[str] = None, note: str = "") -> dict:
    """Run the mini genbench, return task_success in [0.0, 1.0].

    Logs to .lae/l9/ab_validation.jsonl with:
      ts, proposal_id, note, bench_version, task_success, per_task: [{id, ok, reason}]
    """
    results = []
    for task in FIXED_TASKS:
        r = ask_ego(task["query"], timeout_s=40.0)
        ok, reason = _score_task(task, r)
        results.append({"id": task["id"], "ok": ok, "reason": reason})

    n_ok = sum(1 for r in results if r["ok"])
    score = round(n_ok / len(FIXED_TASKS), 6)

    # 2026-09-10: if every task died on transport (submit/poll failed) the run
    # measured nothing -- treating it as a 0.0 baseline caused blind rollbacks.
    _transport_fail = sum(1 for r in results
                          if isinstance(r.get("reason"), str)
                          and r["reason"].startswith(("error: submit failed", "error: poll failed")))
    _measured = _transport_fail < len(results)
    if not _measured:
        entry_note = (note + " [unmeasured_transport]") if note else "unmeasured_transport"
    else:
        entry_note = note

    entry = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "proposal_id": proposal_id,
        "note": entry_note,
        "bench_version": BENCH_VERSION,
        "task_success": score,
        "per_task": results,
        "n_passed": n_ok,
        "n_total": len(FIXED_TASKS),
        "measured": _measured,
        "internal": snapshot_internal(),
    }

    try:
        AB_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(AB_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except Exception as exc:
        print(f"[ab_validate] log write failed: {exc}", file=sys.stderr)

    return entry


def ab_validate_pair(proposal_id: Optional[str] = None,
                     apply_fn=None) -> dict:
    """v2 新增：一次调用完成「应用前 / 应用后」双测，并把结论落到对应日志。

    修复的核心缺陷：原先 975 条记录里 943 条(97%)只有 pre_apply 前测，
    没有后测，A/B 名不副实 —— 只测前不测后，delta 永远算不出来。

    apply_fn: 可选的回调（执行实际的补丁应用）。若为 None，则只做"当前态"两次
    测量（等价于 repeatability 检查），安全无副作用。

    返回: {before, after, delta, verdict, events}
      verdict ∈ {first_run, improved, degraded, stable}
    """
    before = ab_validate(proposal_id=proposal_id, note="v2_pre_apply")
    before_score = float(before.get("task_success", 0.0))

    prev_baseline = load_last_baseline()

    after = before
    if callable(apply_fn):
        try:
            apply_fn()
        except Exception as exc:
            return {"before": before, "after": None, "delta": 0.0,
                    "verdict": "apply_failed", "events": [],
                    "error": str(exc)[:200]}
        after = ab_validate(proposal_id=proposal_id, note="v2_post_apply")

    after_score = float(after.get("task_success", 0.0))

    delta, verdict = score_alert(after_score, before_score)
    # 2026-09-10: never alert/rollback on unmeasured (all-transport-fail) runs
    if not (_entry_measured(after) and _entry_measured(before)):
        delta, verdict = 0.0, "unmeasured_transport"
    events = []

    if verdict == "improved":
        events.append(mark_improved(proposal_id or "", after_score, before_score, delta,
                                    {"kind": "pair"}))
    elif verdict == "degraded":
        events.append(write_degraded_alert(after_score, before_score, delta,
                                           proposal_id or "", {"kind": "pair"}))
        if delta <= -ROLLBACK_THRESHOLD:
            events.append(mark_rolled_back(proposal_id or "", after_score, before_score, delta,
                                           reason=f"delta <= -{ROLLBACK_THRESHOLD} (alert=degraded)",
                                           extra={"kind": "pair"}))

    save_last_baseline(after_score, proposal_id=str(proposal_id or ""))

    return {
        "before": before,
        "after": after,
        "prev_baseline": prev_baseline,
        "delta": delta,
        "verdict": verdict,
        "events": events,
        "bench_version": BENCH_VERSION,
    }


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "single"
    if mode == "pair":
        entry = ab_validate_pair()
    else:
        pid = None if mode in ("single", "manual") else mode
        note = sys.argv[2] if len(sys.argv) > 2 else "manual"
        entry = ab_validate(proposal_id=pid, note=note)
    print(json.dumps(entry, ensure_ascii=False, indent=2))
    print(f"\nLogged to: {AB_LOG}")
